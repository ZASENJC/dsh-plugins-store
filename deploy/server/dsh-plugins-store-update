#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="/opt/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export HOME="/opt/dsh-plugins-store"
export NPM_CONFIG_CACHE="/opt/dsh-plugins-store/.npm-cache"
export ASTRO_TELEMETRY_DISABLED=1

readonly APP_DIR="/opt/dsh-plugins-store"
readonly REPOSITORY_DIR="${APP_DIR}/repository"
readonly RELEASES_DIR="${APP_DIR}/releases"
readonly CURRENT_LINK="${APP_DIR}/current"
readonly REPOSITORY_URL="https://github.com/ZASENJC/dsh-plugins-store.git"

mkdir -p "${APP_DIR}" "${RELEASES_DIR}" "${NPM_CONFIG_CACHE}"

if [[ ! -d "${REPOSITORY_DIR}/.git" ]]; then
  git clone --depth 1 --branch main "${REPOSITORY_URL}" "${REPOSITORY_DIR}"
fi

cd "${REPOSITORY_DIR}"
git restore --source=HEAD -- src/data/catalog.json
git fetch --depth 1 origin main
git merge --ff-only FETCH_HEAD

lock_hash="$(sha256sum package-lock.json | cut -d' ' -f1)"
installed_hash="$(cat "${APP_DIR}/.installed-lock-sha" 2>/dev/null || true)"
if [[ "${lock_hash}" != "${installed_hash}" || ! -d node_modules ]]; then
  npm ci --no-audit --no-fund
  printf '%s\n' "${lock_hash}" > "${APP_DIR}/.installed-lock-sha"
fi

npm run sync
./node_modules/.bin/astro build

release_name="$(date -u +%Y%m%dT%H%M%SZ)"
release_dir="${RELEASES_DIR}/${release_name}"
mkdir "${release_dir}"
cp -a dist/. "${release_dir}/"

ln -sfn "releases/${release_name}" "${APP_DIR}/current.next"
mv -Tf "${APP_DIR}/current.next" "${CURRENT_LINK}"

mapfile -t stale_releases < <(
  find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
    sort -r |
    tail -n +4
)

for stale_release in "${stale_releases[@]}"; do
  [[ "${stale_release}" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || continue
  stale_path="${RELEASES_DIR}/${stale_release}"
  [[ "${stale_path}" == "${RELEASES_DIR}/"* ]] || continue
  rm -rf -- "${stale_path}"
done

echo "Published ${release_name} from $(git rev-parse --short HEAD)"
