[Unit]
Description=Refresh and publish DSH Plugin Store
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/dsh-plugins-store
ExecStart=/usr/bin/flock -n /run/lock/dsh-plugins-store-update.lock /usr/local/sbin/dsh-plugins-store-update
Environment=PATH=/opt/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/opt/dsh-plugins-store
Environment=NPM_CONFIG_CACHE=/opt/dsh-plugins-store/.npm-cache
Environment=ASTRO_TELEMETRY_DISABLED=1
UMask=0022
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/dsh-plugins-store /run/lock

[Install]
WantedBy=multi-user.target
