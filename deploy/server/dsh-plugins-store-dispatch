#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly API_URL="https://api.github.com/repos/ZASENJC/dsh-plugins-store/actions/workflows/sync-catalog.yml/dispatches"
readonly CREDENTIAL_PATH="${CREDENTIALS_DIRECTORY:-}/github-token"

if [[ ! -r "${CREDENTIAL_PATH}" ]]; then
  echo "GitHub dispatch credential is unavailable" >&2
  exit 78
fi

github_token="$(<"${CREDENTIAL_PATH}")"
if [[ -z "${github_token}" ]]; then
  echo "GitHub dispatch credential is empty" >&2
  exit 78
fi

# Skip when a refresh is already waiting in the queue: the concurrency group
# keeps only one pending run anyway, and duplicate timers (e.g. an old and a
# new host during a migration) would otherwise double the work. Fail open if
# the status query itself fails.
readonly RUNS_URL="https://api.github.com/repos/ZASENJC/dsh-plugins-store/actions/workflows/sync-catalog.yml/runs"
for queued_status in queued pending waiting; do
  queued_body="$({
    /usr/bin/curl --config - <<EOF
silent
url = "${RUNS_URL}?status=${queued_status}&per_page=1"
header = "Accept: application/vnd.github+json"
header = "Authorization: Bearer ${github_token}"
header = "X-GitHub-Api-Version: 2022-11-28"
connect-timeout = 10
max-time = 20
EOF
  } || true)"
  if [[ "${queued_body}" =~ \"total_count\":[[:space:]]*[1-9] ]]; then
    unset github_token
    echo "A DSH Plugin Store refresh is already ${queued_status}; not queuing another"
    exit 0
  fi
done

response_code="$({
  /usr/bin/curl --config - --write-out '%{http_code}' <<EOF
silent
show-error
request = "POST"
url = "${API_URL}"
header = "Accept: application/vnd.github+json"
header = "Authorization: Bearer ${github_token}"
header = "X-GitHub-Api-Version: 2022-11-28"
data = "{\"ref\":\"main\"}"
output = "/dev/null"
connect-timeout = 15
max-time = 30
retry = 2
retry-delay = 5
EOF
})"
unset github_token

if [[ "${response_code}" != "204" ]]; then
  echo "GitHub workflow dispatch failed with HTTP ${response_code}" >&2
  exit 69
fi

echo "Queued DSH Plugin Store refresh"
