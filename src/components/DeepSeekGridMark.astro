  [[18, 46]],
  [[20, 45]],
  [[22, 43]],
  [[24, 40]],
  [[29, 36]],
  [], [], [], [], [], [], [], [], [], [], [], [], [], [],
]

let pixelPath = ''

ROW_RUNS.forEach((runs, y) => {
  runs.forEach(([start, end]) => {
    for (let x = start; x <= end; x += 1) {
      pixelPath += `M${x + 0.08} ${y + 0.08}h.84v.84h-.84z`
    }
  })
})
---

<svg
  class:list={['catalog-head__grid-mark', className]}
  viewBox="0 0 80 80"
  data-grid-size="80"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
  style={`opacity:${opacity}`}
>
  <defs>
    <linearGradient id={gradientId} data-gradient="deepseek-grid-gradient" gradientUnits="userSpaceOnUse" x1="8" y1="10" x2="72" y2="70">
      <stop offset="0" stop-color="#151515" stop-opacity="0.55" />
      <stop offset="0.28" stop-color="#f2f2f2" stop-opacity="0.08" />
      <stop offset="0.52" stop-color="#7b7b7b" stop-opacity="0.18" />
      <stop offset="0.76" stop-color="#d2d2d2" stop-opacity="0.1" />
      <stop offset="1" stop-color="#121212" stop-opacity="0.5" />
    </linearGradient>
  </defs>
  <path d={pixelPath} fill={`url(#${gradientId})`} />
</svg>

<style>
  svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
