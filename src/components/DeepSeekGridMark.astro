---
interface Props {
  class?: string
  gradientId: string
  opacity?: number
}

const { class: className, gradientId, opacity = 1 } = Astro.props

type Run = readonly [number, number]

// Quantized from public/deepseek-mark.svg onto an 80-cell canvas with edge padding.
const ROW_RUNS: Run[][] = [
  [], [], [], [], [], [], [], [], [], [], [], [], [], [],
  [[53, 53]],
  [[53, 54]],
  [[35, 41], [52, 54]],
  [[23, 27], [32, 40], [52, 55]],
  [[18, 39], [52, 56]],
  [[16, 39], [52, 58], [73, 74]],
  [[14, 39], [52, 59], [71, 74]],
  [[13, 39], [52, 60], [67, 74]],
  [[12, 41], [52, 61], [64, 74]],
  [[11, 42], [52, 61], [63, 73]],
  [[10, 43], [52, 73]],
  [[9, 44], [53, 73]],
  [[8, 45], [53, 72]],
  [[8, 46], [54, 71]],
  [[7, 47], [55, 71]],
  [[7, 48], [56, 69]],
  [[6, 49], [57, 68]],
  [[6, 50], [57, 66]],
  [[6, 52], [57, 63]],
  [[5, 9], [19, 53], [57, 63]],
  [[5, 9], [22, 63]],
  [[5, 9], [24, 41], [46, 62]],
  [[5, 9], [26, 41], [47, 62]],
  [[5, 9], [27, 43], [48, 62]],
  [[5, 9], [29, 41], [43, 44], [49, 62]],
  [[5, 9], [30, 41], [43, 44], [50, 62]],
  [[5, 10], [31, 44], [50, 61]],
  [[5, 10], [32, 44], [51, 61]],
  [[5, 10], [33, 45], [51, 61]],
  [[6, 10], [34, 46], [51, 60]],
  [[6, 11], [35, 60]],
  [[6, 11], [35, 59]],
  [[6, 12], [36, 59]],
  [[7, 12], [37, 58]],
  [[7, 13], [37, 58]],
  [[7, 14], [38, 57]],
  [[8, 14], [39, 57]],
  [[8, 15], [39, 56]],
  [[9, 16], [28, 30], [40, 55]],
  [[10, 17], [28, 32], [41, 54]],
  [[10, 18], [28, 33], [42, 54]],
  [[11, 19], [29, 35], [43, 53]],
  [[12, 21], [29, 36], [44, 55]],
  [[13, 22], [29, 37], [45, 57]],
