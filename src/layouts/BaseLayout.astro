---
import { CodeXml } from '@lucide/astro'
import { Github } from 'simple-icons-astro'

import {
  getCanonicalUrl,
  HOME_DESCRIPTION,
  HOME_TITLE,
  serializeJsonLd,
} from '../lib/seo'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  structuredData?: Record<string, unknown>
}

const {
  title = HOME_TITLE,
  description = HOME_DESCRIPTION,
  structuredData,
} = Astro.props
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`
const canonicalUrl = getCanonicalUrl(Astro.url)
const cloudflareAnalyticsConfig = import.meta.env.PROD
  ? JSON.stringify({ token: 'cefc4fa1bb984a789124d58b900f13b8' })
  : null
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="DSH插件商店" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    {structuredData && (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)}></script>
    )}
    {
      cloudflareAnalyticsConfig && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={cloudflareAnalyticsConfig}
        ></script>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={baseUrl} aria-label="返回 DSH 插件商店首页">
          <span class="brand__name">DSH插件商店</span>
          <span class="brand__en">DSH-plugin store</span>
        </a>
        <nav aria-label="主导航">
          <a
            class="outline-button"
            href="https://github.com/topics/dsh-plugin"
            target="_blank"
            rel="noreferrer"
          >
            <CodeXml size={16} stroke-width={1.6} />
            <span>GitHub Topic</span>
          </a>
          <a
            class="icon-button"
            href="https://github.com/ZASENJC/dsh-plugins-store"
            target="_blank"
            rel="noreferrer"
            aria-label="查看项目源码"
            title="查看项目源码"
          >
            <Github size={17} aria-hidden="true" />
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__brand">
          <p>DSH插件商店</p>
          <span aria-hidden="true">·</span>
          <a
            href="https://github.com/ZASENJC/dsh-plugins-store"
            target="_blank"
            rel="noreferrer"
            aria-label="查看 DSH插件商店项目源码"
          >
            <Github size={12} aria-hidden="true" />
            © 2026 ZASENJC · MIT
          </a>
          <span class="site-footer__star-prompt">
            <span aria-hidden="true">·</span>
            <a
              href="https://github.com/ZASENJC/dsh-plugins-store"
              target="_blank"
              rel="noreferrer"
              aria-label="在 GitHub 为 DSH插件商店点 Star"
            >
              觉得有帮助？欢迎给项目点个 Star ❤️
            </a>
          </span>
        </div>
        <p>数据来自 GitHub Topic，收录不代表审核、兼容或安全背书。</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgba(33, 35, 39, 0.86);
    background: rgba(10, 10, 10, 0.94);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
  }

  .brand__name {
    font-size: 15px;
    line-height: 20px;
  }

  .brand__en {
    color: var(--mute);
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 20px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .site-footer {
    border-top: 1px solid var(--hairline);
    color: var(--mute);
  }

  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-block: 48px;
    font-size: 13px;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer__brand {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .site-footer__star-prompt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .site-footer__brand a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--mute);
    font-size: inherit;
    line-height: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .site-footer__brand a :global(svg) {
    flex: 0 0 auto;
  }

  .site-footer__brand a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  @media (max-width: 767px) {
    .brand__en,
    nav .outline-button span {
      display: none;
    }

    .site-footer__inner {
      display: grid;
      padding-block: 32px;
    }
  }
</style>
