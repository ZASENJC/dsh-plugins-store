---
import { Moon, Sun } from '@lucide/astro'
import { Github } from 'simple-icons-astro'

import { DEFAULT_LOCALE, dictionaries, LOCALE_STORAGE_KEY, SUPPORTED_LOCALES } from '../lib/i18n'
import {
  getCanonicalUrl,
  HOME_DESCRIPTION,
  HOME_TITLE,
  serializeJsonLd,
} from '../lib/seo'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  structuredData?: Record<string, unknown>
  pageTitleKey?: string
  pageTitleParams?: Record<string, string | number>
}

const {
  title = HOME_TITLE,
  description = HOME_DESCRIPTION,
  structuredData,
  pageTitleKey = 'site.pageTitle.home',
  pageTitleParams = {},
} = Astro.props
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`
const canonicalUrl = getCanonicalUrl(Astro.url)
const cloudflareAnalyticsConfig = import.meta.env.PROD
  ? JSON.stringify({ token: 'cefc4fa1bb984a789124d58b900f13b8' })
  : null
const serializedDictionaries = JSON.stringify(dictionaries).replace(/</g, '\\u003c')
const THEME_STORAGE_KEY = 'dsh-theme'
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="theme-color" content="#0a0a0a" />
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      try {
        if (localStorage.getItem(THEME_STORAGE_KEY) === 'light') {
          document.documentElement.dataset.theme = 'light'
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f6f7f8')
        }
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="DSH 插件市场" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    {structuredData && (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)}></script>
    )}
    {
      cloudflareAnalyticsConfig && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={cloudflareAnalyticsConfig}
        ></script>
      )
    }
  </head>
  <body data-i18n-page-title={pageTitleKey} data-i18n-page-title-params={JSON.stringify(pageTitleParams)}>
    <header class="site-header">
      <div class="container site-header__inner">
        <a
          class="brand"
          href={baseUrl}
          aria-label="返回 DeepSeek-Harness 插件市场首页"
          data-i18n-aria-label="site.homeAria"
        >
          <span class="brand__name" data-i18n="site.brand">DeepSeek-Harness 插件市场</span>
        </a>
        <nav aria-label="主导航" data-i18n-aria-label="nav.main">
          <div class="language-switcher" role="group" aria-label="切换语言" data-i18n-aria-label="language.label">
            <button
              class="language-option"
              type="button"
              data-locale="zh-CN"
              aria-label="中文"
              title="中文"
              aria-pressed="true"
            ><span class="language-option__glyph" aria-hidden="true">中</span></button>
            <button
              class="language-option"
              type="button"
              data-locale="en"
              aria-label="English"
              title="English"
              aria-pressed="false"
            ><span class="language-option__glyph" aria-hidden="true">A</span></button>
            <button
              class="language-option"
              type="button"
              data-locale="ja"
              aria-label="日本語"
              title="日本語"
              aria-pressed="false"
            ><span class="language-option__glyph" aria-hidden="true">あ</span></button>
          </div>
          <button
            id="theme-toggle"
            class="icon-button theme-toggle"
            type="button"
            data-theme-toggle
            data-theme="dark"
            aria-label="切换到浅色模式"
            title="切换到浅色模式"
            data-i18n-aria-label="theme.switchToLight"
            data-i18n-title="theme.switchToLight"
            aria-pressed="false"
          >
            <span class="theme-toggle__sun" aria-hidden="true" hidden>
              <Sun size={17} stroke-width={1.8} />
            </span>
            <span class="theme-toggle__moon" aria-hidden="true">
              <Moon size={17} stroke-width={1.8} />
            </span>
          </button>
          <a
            class="icon-button"
            href="https://github.com/ZASENJC/dsh-plugins-store"
            target="_blank"
            rel="noreferrer"
            aria-label="查看项目源码"
            title="查看项目源码"
            data-i18n-aria-label="nav.source"
            data-i18n-title="nav.source"
          >
            <Github size={17} aria-hidden="true" />
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__brand">
          <p data-i18n="site.footerBrand">DSH 插件市场</p>
          <span aria-hidden="true">·</span>
          <a
            href="https://github.com/ZASENJC/dsh-plugins-store"
            target="_blank"
            rel="noreferrer"
            aria-label="查看 DSH 插件市场项目源码"
            data-i18n-aria-label="footer.sourceAria"
          >
            <Github size={12} aria-hidden="true" />
            © 2026 ZASENJC · MIT
          </a>
          <span class="site-footer__star-prompt">
            <span aria-hidden="true">·</span>
            <a
              href="https://github.com/ZASENJC/dsh-plugins-store"
              target="_blank"
              rel="noreferrer"
              aria-label="在 GitHub 为 DSH 插件市场点 Star"
              data-i18n-aria-label="footer.starAria"
              data-i18n="footer.star"
            >
              觉得有帮助？欢迎给项目点个 Star
            </a>
          </span>
        </div>
        <p data-i18n="footer.source">数据来自 GitHub Topic，收录不代表审核、兼容或安全背书。</p>
      </div>
    </footer>
    <script id="site-i18n-data" type="application/json" set:html={serializedDictionaries} is:inline></script>
    <script is:inline define:vars={{ DEFAULT_LOCALE, LOCALE_STORAGE_KEY, SUPPORTED_LOCALES, THEME_STORAGE_KEY }}>
      const dictionaries = JSON.parse(document.getElementById('site-i18n-data').textContent)
      const languageButtons = Array.from(document.querySelectorAll('[data-locale]'))
      let currentLocale = DEFAULT_LOCALE

      const resolveLocale = (value) => {
        const normalized = String(value ?? '').trim().toLowerCase()
        if (normalized === 'zh-cn' || normalized.startsWith('zh-')) return 'zh-CN'
        if (normalized === 'en' || normalized.startsWith('en-')) return 'en'
        if (normalized === 'ja' || normalized.startsWith('ja-')) return 'ja'
        return DEFAULT_LOCALE
      }

      const getParams = (element) => Object.fromEntries(
        Array.from(element.attributes)
          .filter((attribute) => attribute.name.startsWith('data-i18n-param-'))
          .map((attribute) => [attribute.name.slice('data-i18n-param-'.length), attribute.value]),
      )

      const t = (key, params = {}) => {
        const template = dictionaries[currentLocale]?.[key]
          ?? dictionaries[DEFAULT_LOCALE]?.[key]
          ?? key
        return template.replace(/\{([a-zA-Z][\w-]*)\}/g, (match, name) => (
          Object.prototype.hasOwnProperty.call(params, name) ? String(params[name]) : match
        ))
      }

      const relativeDate = (value) => {
        const date = new Date(value)
        if (Number.isNaN(date.getTime())) return t('date.unknown')
        const days = Math.max(0, Math.floor((Date.now() - date.getTime()) / 86400000))
        if (days === 0) return t('date.today')
        if (days < 30) return t('date.daysAgo', { count: days })
        if (days < 365) return t('date.monthsAgo', { count: Math.floor(days / 30) })
        return t('date.yearsAgo', { count: Math.floor(days / 365) })
      }

      const absoluteDate = (value, includeTime = false) => {
        const date = new Date(value)
        if (Number.isNaN(date.getTime())) return t('date.unknown')
        const locale = currentLocale === 'zh-CN' ? 'zh-CN' : currentLocale === 'ja' ? 'ja-JP' : 'en-US'
        return new Intl.DateTimeFormat(locale, {
          timeZone: 'Asia/Shanghai',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          ...(includeTime ? { hour: '2-digit', minute: '2-digit', hour12: false } : {}),
        }).format(date)
      }

      const nodes = (root, selector) => {
        const matches = root instanceof Element && root.matches(selector) ? [root] : []
        return [...matches, ...root.querySelectorAll(selector)]
      }

      const translate = (root = document) => {
        nodes(root, '[data-i18n]').forEach((element) => {
          element.textContent = t(element.dataset.i18n, getParams(element))
        })
        for (const [dataAttribute, attribute] of [
          ['data-i18n-aria-label', 'aria-label'],
          ['data-i18n-title', 'title'],
          ['data-i18n-placeholder', 'placeholder'],
        ]) {
          nodes(root, `[${dataAttribute}]`).forEach((element) => {
            element.setAttribute(attribute, t(element.getAttribute(dataAttribute), getParams(element)))
          })
        }
        nodes(root, '[data-i18n-relative-date]').forEach((element) => {
          element.textContent = relativeDate(element.dataset.i18nRelativeDate)
        })
        nodes(root, '[data-i18n-date]').forEach((element) => {
          element.textContent = absoluteDate(
            element.dataset.i18nDate,
            element.hasAttribute('data-i18n-date-time'),
          )
        })
        nodes(root, '[data-i18n-validation-title]').forEach((element) => {
          const status = t(`validation.status.${element.dataset.i18nValidationTitle}`)
          element.setAttribute('title', t('card.validationTitle', { status }))
        })
        nodes(root, '[data-i18n-topic-list]').forEach((element) => {
          let topics = []
          try { topics = JSON.parse(element.dataset.i18nTopicList || '[]') } catch {}
          element.textContent = topics.length > 0
            ? topics.join(currentLocale === 'en' ? ', ' : '、')
            : t('detail.noMatchedTags')
        })

        const pageTitleKey = document.body.dataset.i18nPageTitle
        if (root === document && pageTitleKey) {
          let pageTitleParams = {}
          try {
            pageTitleParams = JSON.parse(document.body.dataset.i18nPageTitleParams || '{}')
          } catch {}
          const pageTitle = t(pageTitleKey, pageTitleParams)
          document.title = pageTitle
          document.querySelector('meta[property="og:title"]')?.setAttribute('content', pageTitle)
          document.querySelector('meta[name="twitter:title"]')?.setAttribute('content', pageTitle)
        }
      }

      const setLocale = (locale, persist = true) => {
        currentLocale = SUPPORTED_LOCALES.includes(resolveLocale(locale)) ? resolveLocale(locale) : DEFAULT_LOCALE
        document.documentElement.lang = currentLocale
        languageButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.locale === currentLocale))
        })
        if (persist) {
          try { localStorage.setItem(LOCALE_STORAGE_KEY, currentLocale) } catch {}
        }
        translate(document)
        document.dispatchEvent(new CustomEvent('dsh:locale-change', { detail: { locale: currentLocale } }))
      }

      window.dshI18n = {
        get locale() { return currentLocale },
        t,
        translate,
        relativeDate,
        absoluteDate,
        setLocale,
      }

      languageButtons.forEach((button) => {
        button.addEventListener('click', () => setLocale(button.dataset.locale))
      })
      let savedLocale = DEFAULT_LOCALE
      try { savedLocale = localStorage.getItem(LOCALE_STORAGE_KEY) || DEFAULT_LOCALE } catch {}
      setLocale(savedLocale, false)

      const themeToggle = document.getElementById('theme-toggle')
      const themeToggleSun = themeToggle?.querySelector('.theme-toggle__sun')
      const themeToggleMoon = themeToggle?.querySelector('.theme-toggle__moon')
      const themeColorMeta = document.querySelector('meta[name="theme-color"]')
      const siteHeader = document.querySelector('.site-header')
      const updateThemeControl = (theme) => {
        const labelKey = theme === 'light' ? 'theme.switchToDark' : 'theme.switchToLight'
        themeToggle?.setAttribute('data-i18n-aria-label', labelKey)
        themeToggle?.setAttribute('data-i18n-title', labelKey)
        themeToggle?.setAttribute('aria-label', t(labelKey))
        themeToggle?.setAttribute('title', t(labelKey))
      }

      const applyTheme = (theme, persist = true) => {
        const nextTheme = theme === 'light' ? 'light' : 'dark'
        document.documentElement.dataset.theme = nextTheme
        themeToggle?.setAttribute('data-theme', nextTheme)
        themeToggle?.setAttribute('aria-pressed', String(nextTheme === 'light'))
        themeColorMeta?.setAttribute('content', nextTheme === 'light' ? '#f6f7f8' : '#0a0a0a')
        if (themeToggleSun) {
          themeToggleSun.hidden = nextTheme !== 'light'
          themeToggleSun.style.display = nextTheme === 'light' ? 'inline-flex' : 'none'
        }
        if (themeToggleMoon) {
          themeToggleMoon.hidden = nextTheme !== 'dark'
          themeToggleMoon.style.display = nextTheme === 'dark' ? 'inline-flex' : 'none'
        }
        siteHeader?.style.setProperty(
          'background-color',
          nextTheme === 'light' ? 'rgba(246, 247, 248, 0.94)' : 'rgba(10, 10, 10, 0.94)',
        )
        siteHeader?.style.setProperty(
          'border-bottom-color',
          nextTheme === 'light' ? 'rgba(214, 219, 224, 0.92)' : 'rgba(33, 35, 39, 0.86)',
        )
        updateThemeControl(nextTheme)
        if (persist) {
          try { localStorage.setItem(THEME_STORAGE_KEY, nextTheme) } catch {}
        }
      }

      themeToggle?.addEventListener('click', () => {
        applyTheme(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light')
      })
      document.addEventListener('dsh:locale-change', () => {
        updateThemeControl(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')
      })
      let savedTheme = 'dark'
      try { savedTheme = localStorage.getItem(THEME_STORAGE_KEY) || 'dark' } catch {}
      applyTheme(savedTheme, false)
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--header-border);
    background: var(--header-background);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
  }

  .brand__name {
    font-size: 15px;
    line-height: 20px;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .language-switcher {
    display: grid;
    grid-template-columns: repeat(3, 30px);
    align-items: center;
    height: 40px;
    border: 1px solid var(--outline);
    border-radius: 9999px;
    color: var(--body);
    overflow: hidden;
  }

  .language-option {
    display: grid;
    width: 30px;
    height: 100%;
    place-items: center;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    padding: 0;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .language-option + .language-option {
    border-left: 1px solid var(--outline);
  }

  .language-option:hover {
    background: var(--canvas-soft);
    color: var(--ink);
  }

  .language-option[aria-pressed='true'] {
    background: var(--ink);
    color: var(--canvas);
  }

  .language-option__glyph {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
  }

  .site-footer {
    border-top: 1px solid var(--hairline);
    color: var(--mute);
  }

  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-block: 48px;
    font-size: 13px;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer__brand {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .site-footer__star-prompt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .site-footer__brand a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--mute);
    font-size: inherit;
    line-height: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .site-footer__brand a :global(svg) {
    flex: 0 0 auto;
  }

  .site-footer__brand a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  @media (max-width: 767px) {
    .site-header__inner {
      gap: 8px;
    }

    .language-switcher {
      height: 44px;
    }

    .brand__name {
      display: block;
      max-width: calc(100vw - 166px);
      overflow: hidden;
      font-size: 13px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .site-footer__inner {
      display: grid;
      padding-block: 32px;
    }
  }
</style>
