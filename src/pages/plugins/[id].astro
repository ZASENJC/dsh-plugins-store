---
import {
  ArrowLeft,
  ArrowUpRight,
  BookOpen,
  CalendarDays,
  Check,
  ChevronDown,
  CircleAlert,
  CircleDot,
  Copy,
  Download,
  ExternalLink,
  GitFork,
  CodeXml,
  Scale,
  Star,
} from '@lucide/astro'

import ProjectCard from '../../components/ProjectCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatCompactNumber, formatRelativeDate, sortCatalogEntries, type Catalog, type CatalogEntry } from '../../lib/catalog'
import { catalogData } from '../../lib/catalog-data'
import { getCategory, getProjectTypeLabel } from '../../lib/classification'
import { getReadmeApiUrl } from '../../lib/readme'
import { buildLocalDshInstallUrl } from '../../lib/dsh-install-link'
import { VALIDATION_STAGE_DEFINITIONS } from '../../lib/validation'

export function getStaticPaths() {
  const catalog = catalogData as Catalog
  return catalog.repositories.map((repository) => ({
    params: { id: repository.slug },
    props: { repository },
  }))
}

interface Props {
  repository: CatalogEntry
}

const { repository } = Astro.props as Props
const category = getCategory(repository.category)
const installableTypes = new Set(['plugin', 'skill', 'collection', 'channel'])
const showInstallReference = installableTypes.has(repository.projectType)
const installRef = repository.validation.verified && repository.validation.sourceSha
  ? `#${repository.validation.sourceSha}`
  : ''
const installCommand = `dsh plugin --profile web add github:${repository.fullName}${installRef}`
const localDshInstallUrl = buildLocalDshInstallUrl(repository.fullName)
const validationStageStatusLabels = {
  pending: '等待处理',
  running: '正在执行',
  passed: '已通过',
  failed: '未通过',
  inconclusive: '需要复核',
  skipped: '不适用',
}
const validationUpdatedAt = repository.validation.updatedAt
  ? new Intl.DateTimeFormat('zh-CN', {
      timeZone: 'Asia/Shanghai',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).format(new Date(repository.validation.updatedAt))
  : null
const related = sortCatalogEntries(
  (catalogData as Catalog).repositories
    .filter((item) => item.repositoryId !== repository.repositoryId && item.category === repository.category),
  'recommended',
).slice(0, 3)
const readmeApiUrl = getReadmeApiUrl(repository.fullName)
const absoluteDate = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date(repository.pushedAt))
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`
---

<BaseLayout
  title={`${repository.name} · DSH 插件市场`}
  description={repository.description}
  pageTitleKey="site.pageTitle.detail"
  pageTitleParams={{ name: repository.name }}
>
  <section class="detail-hero">
    <div class="container">
      <a class="back-link" href={baseUrl} data-catalog-back>
        <ArrowLeft size={16} stroke-width={1.6} />
        <span data-i18n="detail.back">返回目录</span>
      </a>

      <div class="detail-hero__grid">
        <div class="detail-identity">
          <div class="detail-eyebrow">
            <span class="category-dot" style={`--category-color: ${category.color}`}></span>
            <span class="mono-label" data-i18n={`category.${repository.category}`}>{category.label}</span>
            <span data-i18n={`projectType.${repository.projectType}`}>{getProjectTypeLabel(repository.projectType)}</span>
          </div>
          <div class="detail-title">
            <img src={repository.owner.avatarUrl} width="56" height="56" alt="" />
            <div>
              <h1>{repository.name}</h1>
              <p>{repository.fullName}</p>
            </div>
          </div>
          <p class="detail-description">{repository.description}</p>
          <div class="detail-actions">
            <a class="primary-button" href={repository.url} target="_blank" rel="noreferrer">
              <CodeXml size={17} stroke-width={1.6} />
              <span data-i18n="detail.viewRepository">查看仓库</span>
              <ArrowUpRight size={15} stroke-width={1.6} />
            </a>
            {repository.homepage && (
              <a class="outline-button" href={repository.homepage} target="_blank" rel="noreferrer">
                <ExternalLink size={16} stroke-width={1.6} />
                <span data-i18n="detail.homepage">项目主页</span>
              </a>
            )}
          </div>
        </div>

        <dl class="detail-metrics" aria-label="仓库指标" data-i18n-aria-label="detail.metrics">
          <div><dt><Star size={15} stroke-width={1.6} /> Stars</dt><dd>{formatCompactNumber(repository.stars)}</dd></div>
          <div><dt><GitFork size={15} stroke-width={1.6} /> Forks</dt><dd>{formatCompactNumber(repository.forks)}</dd></div>
          <div><dt><CircleDot size={15} stroke-width={1.6} /> Issues</dt><dd>{formatCompactNumber(repository.openIssues)}</dd></div>
          <div>
            <dt><CalendarDays size={15} stroke-width={1.6} /> <span data-i18n="detail.updated">更新</span></dt>
            <dd data-i18n-relative-date={repository.pushedAt}>{formatRelativeDate(repository.pushedAt)}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="detail-content">
    <div class="container detail-content__grid">
      <div class="detail-main">
        <section class="detail-section">
          <p class="mono-label">PROJECT TOPICS</p>
          <h2 data-i18n="detail.tags">项目标签</h2>
          <div class="topic-cloud">
            {repository.topics.map((topic) => (
              <a
                href={`${baseUrl}topics/${encodeURIComponent(topic)}`}
                aria-label={`查看包含 ${topic} 标签的所有项目`}
                data-i18n-aria-label="detail.tagAria"
                data-i18n-param-topic={topic}
              >
                {topic}
              </a>
            ))}
          </div>
        </section>

        <section class="detail-section validation-section" data-validation-status={repository.validation.overall}>
          <div class="validation-heading">
            <div>
              <p class="mono-label">VALIDATION LADDER</p>
              <h2 data-i18n="detail.validationProgress">验证进度</h2>
            </div>
            <span data-tone={repository.validation.tone}>
              <CircleDot size={14} stroke-width={1.8} />
              <span data-i18n={`validation.status.${repository.validation.overall}`}>{repository.validation.label}</span>
            </span>
          </div>
          <div class="validation-ladder">
            {VALIDATION_STAGE_DEFINITIONS.map((stage, index) => {
              const evidence = repository.validation.stages[stage.id]
              return (
                <div class="validation-step" data-status={evidence.status}>
                  <span class="validation-step__index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="validation-step__mark"><i></i></span>
                  <span class="validation-step__copy">
                    <strong data-i18n={`validation.stage.${stage.id}`}>{stage.label}</strong>
                    <small data-i18n={`validation.step.${evidence.status}`}>{validationStageStatusLabels[evidence.status]}</small>
                  </span>
                </div>
              )
            })}
          </div>
          {(repository.validation.sourceSha || repository.validation.dshVersion || repository.validation.platform || validationUpdatedAt) && (
            <dl class="validation-evidence">
              {repository.validation.sourceSha && <div><dt>Commit</dt><dd>{repository.validation.sourceSha.slice(0, 12)}</dd></div>}
              {repository.validation.dshVersion && <div><dt>DSH</dt><dd>{repository.validation.dshVersion}</dd></div>}
              {repository.validation.platform && <div><dt data-i18n="detail.platform">平台</dt><dd>{repository.validation.platform}</dd></div>}
              {validationUpdatedAt && (
                <div>
                  <dt data-i18n="detail.validationTime">验证时间</dt>
                  <dd data-i18n-date={repository.validation.updatedAt!} data-i18n-date-time>{validationUpdatedAt}</dd>
                </div>
              )}
            </dl>
          )}
          {repository.validation.reason && <p class="validation-reason">{repository.validation.reason}</p>}
          {(repository.validation.reportUrl || repository.validation.issueUrl) && (
            <div class="validation-actions">
              {repository.validation.reportUrl && (
                <a class="outline-button" href={repository.validation.reportUrl} target="_blank" rel="noreferrer">
                  <span data-i18n="detail.report">查看验证报告</span>
                  <ExternalLink size={14} stroke-width={1.6} />
                </a>
              )}
              {repository.validation.issueUrl && (
                <a class="outline-button" href={repository.validation.issueUrl} target="_blank" rel="noreferrer">
                  <span data-i18n="detail.issue">查看相关 Issue</span>
                  <ExternalLink size={14} stroke-width={1.6} />
                </a>
              )}
            </div>
          )}
        </section>

        <section class="detail-section readme-section">
          <details
            class="readme-disclosure"
            id="readme-disclosure"
            data-readme-api={readmeApiUrl}
            data-full-name={repository.fullName}
            data-default-branch={repository.defaultBranch}
          >
            <summary>
              <span class="readme-heading">
                <span class="mono-label">PROJECT README</span>
                <span class="readme-title"><BookOpen size={20} stroke-width={1.6} /> README</span>
              </span>
              <span class="readme-toggle">
                <span class="readme-toggle__closed" data-i18n="detail.readmeExpand">展开</span>
                <span class="readme-toggle__open" data-i18n="detail.readmeCollapse">收起</span>
                <ChevronDown size={18} stroke-width={1.6} />
              </span>
            </summary>
            <div class="readme-content" id="readme-content" aria-live="polite" aria-busy="false">
              <p class="readme-state" id="readme-state" data-i18n="detail.readmeLoading">正在读取 GitHub README...</p>
              <div class="markdown-body" id="readme-body" hidden></div>
              <div class="readme-error" id="readme-error" hidden>
                <p id="readme-error-message" data-i18n="detail.readmeFailed">README 暂时无法读取。</p>
                <button class="outline-button" id="retry-readme" type="button" data-i18n="detail.retry">重试</button>
                <a class="outline-button" href={repository.url} target="_blank" rel="noreferrer" data-i18n="detail.goRepository">前往仓库</a>
              </div>
            </div>
          </details>
        </section>

        <section class="detail-section classification-section">
          <p class="mono-label">CLASSIFICATION EVIDENCE</p>
          <h2 data-i18n="detail.classification">分类依据</h2>
          <div class="classification-grid">
            <div>
              <span data-i18n="detail.projectType">项目类型</span>
              <strong data-i18n={`projectType.${repository.projectType}`}>{getProjectTypeLabel(repository.projectType)}</strong>
            </div>
            <div>
              <span data-i18n="detail.category">功能分类</span>
              <strong data-i18n={`category.${repository.category}`}>{category.label}</strong>
            </div>
            <div>
              <span data-i18n="detail.confidence">规则置信度</span>
              <strong data-i18n={`detail.confidence.${repository.classificationConfidence}`}>
                {repository.classificationConfidence === 'high' ? '高' : repository.classificationConfidence === 'medium' ? '中' : '低'}
              </strong>
            </div>
          </div>
          <p class="classification-note">
            <span data-i18n="detail.classificationPrefix">系统优先读取 GitHub Topics，再与站内分类词典和词根规则比对。当前命中：</span>
            <span data-i18n-topic-list={JSON.stringify(repository.matchedTopics)}>
              {repository.matchedTopics.length > 0 ? repository.matchedTopics.join('、') : '无有效分类标签'}
            </span>。
          </p>
        </section>

        {showInstallReference && (
          <section class="detail-section install-section">
            <div class="install-heading">
              <div><p class="mono-label">INSTALL REFERENCE</p><h2 data-i18n="detail.installReference">安装参考</h2></div>
              <span data-tone={repository.validation.tone}>
                <CircleAlert size={15} stroke-width={1.6} />
                <span data-i18n={`validation.status.${repository.validation.overall}`}>{repository.validation.label}</span>
              </span>
            </div>
            <div class="command-row">
              <code id="install-command">{installCommand}</code>
              <button
                class="icon-button"
                id="copy-command"
                type="button"
                aria-label="复制安装参考"
                title="复制安装参考"
                data-i18n-aria-label="detail.copyInstall"
                data-i18n-title="detail.copyInstall"
              >
                <Copy class="copy-icon" size={16} stroke-width={1.6} />
                <Check class="check-icon" size={16} stroke-width={1.6} />
              </button>
            </div>
            <div class="install-actions">
              <a
                class="primary-button install-dsh-button"
                href={localDshInstallUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`在本机 DSH 中安装 ${repository.fullName}`}
                data-i18n-aria-label="detail.installLocalAria"
                data-i18n-param-name={repository.fullName}
              >
                <Download size={17} stroke-width={1.6} />
                <span data-i18n="detail.installLocal">在 DSH 中安装</span>
                <ArrowUpRight size={15} stroke-width={1.6} />
              </a>
            </div>
            <p>
              <span data-i18n={repository.validation.verified ? 'detail.installVerifiedNote' : 'detail.installUnverifiedNote'}>
                {repository.validation.verified
                  ? '该命令已固定到通过当前验证的 commit；验证仍不等同安全审计或官方背书。'
                  : '该命令指向仓库当前默认分支；尚无绑定当前 commit 的完整验证结果。'}
              </span>
            </p>
          </section>
        )}
      </div>

      <aside class="repository-facts" aria-label="仓库信息" data-i18n-aria-label="detail.facts">
        <p class="mono-label">REPOSITORY FACTS</p>
        <dl>
          <div><dt data-i18n="detail.language">主要语言</dt><dd>{repository.language ?? <span data-i18n="common.unknown">未知</span>}</dd></div>
          <div>
            <dt data-i18n="detail.license">许可证</dt>
            <dd><Scale size={14} stroke-width={1.6} /> {repository.license ?? <span data-i18n="common.undeclared">未声明</span>}</dd>
          </div>
          <div><dt data-i18n="detail.lastPush">最后推送</dt><dd data-i18n-date={repository.pushedAt}>{absoluteDate}</dd></div>
          <div>
            <dt data-i18n="detail.archive">归档状态</dt>
            <dd data-i18n={repository.archived ? 'detail.archived' : 'detail.active'}>{repository.archived ? '已归档' : '活跃'}</dd>
          </div>
          <div><dt data-i18n="detail.source">数据来源</dt><dd>GitHub Topic</dd></div>
          <div>
            <dt data-i18n="detail.validation">验证状态</dt>
            <dd class:list={{ 'status-warning': !repository.validation.verified, 'status-verified': repository.validation.verified }}>
              {repository.validation.reportUrl
                ? (
                  <a href={repository.validation.reportUrl} target="_blank" rel="noreferrer">
                    <span data-i18n={`validation.status.${repository.validation.overall}`}>{repository.validation.label}</span>
                    <ExternalLink size={12} stroke-width={1.6} />
                  </a>
                )
                : <span data-i18n={`validation.status.${repository.validation.overall}`}>{repository.validation.label}</span>}
            </dd>
          </div>
          <div>
            <dt>awesome-dsh-plugins</dt>
            <dd
              class:list={{ 'status-listed': repository.awesomeListed }}
              data-i18n={repository.awesomeListed ? 'detail.listed' : 'detail.notListed'}
            >{repository.awesomeListed ? '已收录' : '未收录'}</dd>
          </div>
        </dl>
        <p class="facts-note" data-i18n="detail.factsNote">只有绑定当前 commit 的完整实机结果显示为“已验证”；其他标识仅代表对应步骤的记录。</p>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related-section">
      <div class="container">
        <div class="related-heading">
          <div><p class="mono-label">MORE IN CATEGORY</p><h2 data-i18n="detail.related">同类项目</h2></div>
          <a class="outline-button" href={`${baseUrl}?category=${repository.category}`} data-i18n="detail.browseCategory">浏览分类</a>
        </div>
        <div class="related-grid">
          {related.map((item) => <ProjectCard repository={item} />)}
        </div>
      </div>
    </section>
  )}

  <script>
    import { resolveReadmeReference } from '../../lib/readme'

    const t = (key: string, params: Record<string, string | number> = {}) => (
      window.dshI18n?.t(key, params) ?? key
    )

    const catalogBackLink = document.querySelector<HTMLAnchorElement>('[data-catalog-back]')
    if (catalogBackLink) {
      const catalogFilterParamNames = ['q', 'category', 'type', 'validation', 'sort']
      const currentParams = new URLSearchParams(window.location.search)
      const catalogFilterParams = new URLSearchParams()
      catalogFilterParamNames.forEach((param) => {
        const value = currentParams.get(param)
        if (value) catalogFilterParams.set(param, value)
      })
      const serializedCatalogFilters = catalogFilterParams.toString()
      const catalogFilterSearch = serializedCatalogFilters ? `?${serializedCatalogFilters}` : ''
      catalogBackLink.href = `${catalogBackLink.href}${catalogFilterSearch}`
    }

    const copyButton = document.getElementById('copy-command')
    const installCommandElement = document.getElementById('install-command')
    if (copyButton && installCommandElement) {
      copyButton.addEventListener('click', async () => {
        const command = installCommandElement.textContent ?? ''
        await navigator.clipboard.writeText(command)
        copyButton.classList.add('is-copied')
        copyButton.setAttribute('aria-label', t('detail.copied'))
        copyButton.setAttribute('title', t('detail.copied'))
        window.setTimeout(() => {
          copyButton.classList.remove('is-copied')
          copyButton.setAttribute('aria-label', t('detail.copyInstall'))
          copyButton.setAttribute('title', t('detail.copyInstall'))
        }, 1600)
      })
    }

    const readmeDisclosure = document.querySelector<HTMLDetailsElement>('#readme-disclosure')!
    const readmeContent = document.querySelector<HTMLElement>('#readme-content')!
    const readmeState = document.querySelector<HTMLElement>('#readme-state')!
    const readmeBody = document.querySelector<HTMLElement>('#readme-body')!
    const readmeError = document.querySelector<HTMLElement>('#readme-error')!
    const readmeErrorMessage = document.querySelector<HTMLElement>('#readme-error-message')!
    const retryReadme = document.getElementById('retry-readme')
    let readmeLoaded = false
    let readmeLoading = false

    const setLocalizedText = (element: HTMLElement, key: string) => {
      element.dataset.i18n = key
      element.textContent = t(key)
    }

    const showReadmeError = (messageKey: string) => {
      readmeState.hidden = true
      readmeBody.hidden = true
      setLocalizedText(readmeErrorMessage, messageKey)
      readmeError.hidden = false
    }

    const loadReadme = async () => {
      if (readmeLoaded || readmeLoading) return
      readmeLoading = true
      readmeContent.setAttribute('aria-busy', 'true')
      readmeState.hidden = false
      setLocalizedText(readmeState, 'detail.readmeLoading')
      readmeBody.hidden = true
      readmeError.hidden = true

      try {
        const response = await fetch(readmeDisclosure.dataset.readmeApi!, {
          headers: { Accept: 'application/vnd.github.html+json' },
        })
        if (response.status === 404 || response.status === 409) {
          setLocalizedText(readmeState, 'detail.readmeMissing')
          readmeLoaded = true
          return
        }
        if (response.status === 403 || response.status === 429) {
          throw new Error('detail.readmeRateLimit')
        }
        if (!response.ok) throw new Error('detail.readmeFailed')

        const documentFragment = new DOMParser().parseFromString(await response.text(), 'text/html')
        const wrapper = documentFragment.querySelector('#readme')
        const article = wrapper?.querySelector('article.markdown-body')
        if (!wrapper || !article) throw new Error('detail.readmeMalformed')

        const location = {
          fullName: readmeDisclosure.dataset.fullName!,
          defaultBranch: readmeDisclosure.dataset.defaultBranch || 'main',
          readmePath: wrapper.getAttribute('data-path') || 'README.md',
        }
        article.querySelectorAll('a[href]').forEach((link) => {
          const href = link.getAttribute('href')
          if (!href) return
          link.setAttribute('href', resolveReadmeReference(href, location, 'link'))
          if (!href.startsWith('#')) {
            link.setAttribute('target', '_blank')
            link.setAttribute('rel', 'noreferrer')
          }
        })
        article.querySelectorAll('[src]').forEach((media) => {
          const src = media.getAttribute('src')
          if (src) media.setAttribute('src', resolveReadmeReference(src, location, 'media'))
        })

        readmeBody.replaceChildren(...Array.from(article.childNodes).map((node) => document.importNode(node, true)))
        readmeState.hidden = true
        readmeBody.hidden = false
        readmeLoaded = true
      } catch (error) {
        const messageKey = error instanceof Error && error.message.startsWith('detail.')
          ? error.message
          : 'detail.readmeFailed'
        showReadmeError(messageKey)
      } finally {
        readmeLoading = false
        readmeContent.setAttribute('aria-busy', 'false')
      }
    }

    readmeDisclosure?.addEventListener('toggle', () => {
      if (readmeDisclosure.open) void loadReadme()
    })
    retryReadme?.addEventListener('click', () => void loadReadme())
  </script>
</BaseLayout>

<style>
  .detail-hero { border-bottom: 1px solid var(--hairline); }
  .detail-hero .container { padding-block: 28px 56px; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--mute); font-size: 13px; }
  .back-link:hover { color: var(--ink); }
  .detail-hero__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.6fr); gap: 80px; align-items: end; padding-top: 56px; }
  .detail-eyebrow, .detail-title, .detail-actions, .detail-metrics dt, .repository-facts dd, .install-heading > span { display: flex; align-items: center; }
  .detail-eyebrow { gap: 9px; }
  .detail-eyebrow > span:last-child { border-left: 1px solid var(--hairline); color: var(--mute); font-size: 12px; padding-left: 10px; }
  .category-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--category-color); }
  .detail-title { min-width: 0; gap: 18px; margin-top: 18px; }
  .detail-title img { width: 56px; height: 56px; flex: 0 0 auto; border-radius: 50%; }
  .detail-title > div { min-width: 0; }
  h1, h2, .detail-title p, .detail-description, .install-section > p, .classification-note, .facts-note { margin: 0; }
  h1 { overflow-wrap: anywhere; font-size: clamp(42px, 6vw, 72px); font-weight: 400; line-height: 1; letter-spacing: 0; }
  .detail-title p { margin-top: 6px; color: var(--mute); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0; }
  .detail-description { max-width: 760px; margin-top: 24px; color: var(--body); font-size: 18px; line-height: 30px; }
  .detail-actions { flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .primary-button { display: inline-flex; min-height: 40px; align-items: center; gap: 8px; border: 1px solid var(--ink); border-radius: 9999px; background: var(--ink); color: var(--canvas); font-size: 14px; padding: 8px 16px; }
  .detail-metrics { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border-block: 1px solid var(--hairline); }
  .detail-metrics div { padding: 18px; }
  .detail-metrics div:nth-child(even) { border-left: 1px solid var(--hairline); }
  .detail-metrics div:nth-child(n + 3) { border-top: 1px solid var(--hairline); }
