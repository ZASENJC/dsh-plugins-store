---
import {
  ArrowLeft,
  ArrowUpRight,
  BookOpen,
  CalendarDays,
  Check,
  ChevronDown,
  CircleAlert,
  CircleDot,
  Copy,
  ExternalLink,
  GitFork,
  CodeXml,
  Scale,
  Star,
} from '@lucide/astro'

import ProjectCard from '../../components/ProjectCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatCompactNumber, formatRelativeDate, sortCatalogEntries, type Catalog, type CatalogEntry } from '../../lib/catalog'
import { getCategory, getProjectTypeLabel } from '../../lib/classification'
import { getReadmeApiUrl } from '../../lib/readme'
import catalogData from '../../data/catalog.json'

export function getStaticPaths() {
  const catalog = catalogData as Catalog
  return catalog.repositories.map((repository) => ({
    params: { id: repository.slug },
    props: { repository },
  }))
}

interface Props {
  repository: CatalogEntry
}

const { repository } = Astro.props as Props
const category = getCategory(repository.category)
const installableTypes = new Set(['plugin', 'skill', 'collection', 'channel'])
const showInstallReference = installableTypes.has(repository.projectType)
const installCommand = `dsh plugin --profile web add github:${repository.fullName}`
const related = sortCatalogEntries(
  (catalogData as Catalog).repositories
    .filter((item) => item.repositoryId !== repository.repositoryId && item.category === repository.category),
  'stars',
).slice(0, 3)
const readmeApiUrl = getReadmeApiUrl(repository.fullName)
const verifyDirectoryUrl = 'https://github.com/qing3a/dsh-plugin-verify#verified-%E7%9B%AE%E5%BD%95'
const absoluteDate = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date(repository.pushedAt))
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`
---

<BaseLayout title={`${repository.name} · DSH插件商店`} description={repository.description}>
  <section class="detail-hero">
    <div class="container">
      <a class="back-link" href={baseUrl}><ArrowLeft size={16} stroke-width={1.6} /> 返回目录</a>

      <div class="detail-hero__grid">
        <div class="detail-identity">
          <div class="detail-eyebrow">
            <span class="category-dot" style={`--category-color: ${category.color}`}></span>
            <span class="mono-label">{category.label}</span>
            <span>{getProjectTypeLabel(repository.projectType)}</span>
          </div>
          <div class="detail-title">
            <img src={repository.owner.avatarUrl} width="56" height="56" alt="" />
            <div>
              <h1>{repository.name}</h1>
              <p>{repository.fullName}</p>
            </div>
          </div>
          <p class="detail-description">{repository.description}</p>
          <div class="detail-actions">
            <a class="primary-button" href={repository.url} target="_blank" rel="noreferrer">
              <CodeXml size={17} stroke-width={1.6} /> 查看仓库
              <ArrowUpRight size={15} stroke-width={1.6} />
            </a>
            {repository.homepage && (
              <a class="outline-button" href={repository.homepage} target="_blank" rel="noreferrer">
                <ExternalLink size={16} stroke-width={1.6} /> 项目主页
              </a>
            )}
          </div>
        </div>

        <dl class="detail-metrics" aria-label="仓库指标">
          <div><dt><Star size={15} stroke-width={1.6} /> Stars</dt><dd>{formatCompactNumber(repository.stars)}</dd></div>
          <div><dt><GitFork size={15} stroke-width={1.6} /> Forks</dt><dd>{formatCompactNumber(repository.forks)}</dd></div>
          <div><dt><CircleDot size={15} stroke-width={1.6} /> Issues</dt><dd>{formatCompactNumber(repository.openIssues)}</dd></div>
          <div><dt><CalendarDays size={15} stroke-width={1.6} /> 更新</dt><dd>{formatRelativeDate(repository.pushedAt)}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="detail-content">
    <div class="container detail-content__grid">
      <div class="detail-main">
        <section class="detail-section">
          <p class="mono-label">PROJECT TOPICS</p>
          <h2>项目标签</h2>
          <div class="topic-cloud">
            {repository.topics.map((topic) => (
              <a
                href={`${baseUrl}topics/${encodeURIComponent(topic)}`}
                aria-label={`查看包含 ${topic} 标签的所有项目`}
              >
                {topic}
              </a>
            ))}
          </div>
        </section>

        <section class="detail-section readme-section">
          <details
            class="readme-disclosure"
            id="readme-disclosure"
            data-readme-api={readmeApiUrl}
            data-full-name={repository.fullName}
            data-default-branch={repository.defaultBranch}
          >
            <summary>
              <span class="readme-heading">
                <span class="mono-label">PROJECT README</span>
                <span class="readme-title"><BookOpen size={20} stroke-width={1.6} /> README</span>
              </span>
              <span class="readme-toggle">
                <span class="readme-toggle__closed">展开</span>
                <span class="readme-toggle__open">收起</span>
                <ChevronDown size={18} stroke-width={1.6} />
              </span>
            </summary>
            <div class="readme-content" id="readme-content" aria-live="polite" aria-busy="false">
              <p class="readme-state" id="readme-state">正在读取 GitHub README...</p>
              <div class="markdown-body" id="readme-body" hidden></div>
              <div class="readme-error" id="readme-error" hidden>
                <p id="readme-error-message">README 暂时无法读取。</p>
                <button class="outline-button" id="retry-readme" type="button">重试</button>
                <a class="outline-button" href={repository.url} target="_blank" rel="noreferrer">前往仓库</a>
              </div>
            </div>
          </details>
        </section>

        <section class="detail-section classification-section">
          <p class="mono-label">CLASSIFICATION EVIDENCE</p>
          <h2>分类依据</h2>
          <div class="classification-grid">
            <div><span>项目类型</span><strong>{getProjectTypeLabel(repository.projectType)}</strong></div>
            <div><span>功能分类</span><strong>{category.label}</strong></div>
            <div>
              <span>规则置信度</span>
              <strong>{repository.classificationConfidence === 'high' ? '高' : repository.classificationConfidence === 'medium' ? '中' : '低'}</strong>
            </div>
          </div>
          <p class="classification-note">
            系统优先读取 GitHub Topics，再与站内分类词典和词根规则比对。当前命中：
            {repository.matchedTopics.length > 0 ? repository.matchedTopics.join('、') : '无有效分类标签'}。
          </p>
        </section>

        {showInstallReference && (
          <section class="detail-section install-section">
            <div class="install-heading">
              <div><p class="mono-label">INSTALL REFERENCE</p><h2>安装参考</h2></div>
              <span><CircleAlert size={15} stroke-width={1.6} /> 未验证</span>
            </div>
            <div class="command-row">
              <code id="install-command">{installCommand}</code>
              <button class="icon-button" id="copy-command" type="button" aria-label="复制安装参考" title="复制安装参考">
                <Copy class="copy-icon" size={16} stroke-width={1.6} />
                <Check class="check-icon" size={16} stroke-width={1.6} />
              </button>
            </div>
            <p>该命令依据官方 GitHub 安装格式生成，尚未确认仓库结构、构建脚本或当前 DSH 兼容性。</p>
          </section>
        )}
      </div>

      <aside class="repository-facts" aria-label="仓库信息">
        <p class="mono-label">REPOSITORY FACTS</p>
        <dl>
          <div><dt>主要语言</dt><dd>{repository.language ?? '未知'}</dd></div>
          <div><dt>许可证</dt><dd><Scale size={14} stroke-width={1.6} /> {repository.license ?? '未声明'}</dd></div>
          <div><dt>最后推送</dt><dd>{absoluteDate}</dd></div>
          <div><dt>归档状态</dt><dd>{repository.archived ? '已归档' : '活跃'}</dd></div>
          <div><dt>数据来源</dt><dd>GitHub Topic</dd></div>
          <div>
            <dt>验证状态</dt>
            <dd class:list={{ 'status-warning': !repository.verified, 'status-verified': repository.verified }}>
              {repository.verified
                ? (
                  <a href={verifyDirectoryUrl} target="_blank" rel="noreferrer">
                    已验证 <ExternalLink size={12} stroke-width={1.6} />
                  </a>
                )
                : '尚未验证'}
            </dd>
          </div>
          <div>
            <dt>awesome-dsh-plugins</dt>
            <dd class:list={{ 'status-listed': repository.awesomeListed }}>{repository.awesomeListed ? '已收录' : '未收录'}</dd>
          </div>
        </dl>
        <p class="facts-note">Verified 表示该项目在记录环境中通过运行时验证，不等同官方背书、完整功能测试或安全审计。</p>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related-section">
      <div class="container">
        <div class="related-heading">
          <div><p class="mono-label">MORE IN CATEGORY</p><h2>同类项目</h2></div>
          <a class="outline-button" href={`${baseUrl}?category=${repository.category}`}>浏览分类</a>
        </div>
        <div class="related-grid">
          {related.map((item) => <ProjectCard repository={item} />)}
        </div>
      </div>
    </section>
  )}

  <script>
    import { resolveReadmeReference } from '../../lib/readme'

    const copyButton = document.getElementById('copy-command')
    const installCommandElement = document.getElementById('install-command')
    if (copyButton && installCommandElement) {
      copyButton.addEventListener('click', async () => {
        const command = installCommandElement.textContent ?? ''
        await navigator.clipboard.writeText(command)
        copyButton.classList.add('is-copied')
        copyButton.setAttribute('aria-label', '已复制')
        window.setTimeout(() => {
          copyButton.classList.remove('is-copied')
          copyButton.setAttribute('aria-label', '复制安装参考')
        }, 1600)
      })
    }

    const readmeDisclosure = document.querySelector<HTMLDetailsElement>('#readme-disclosure')!
    const readmeContent = document.querySelector<HTMLElement>('#readme-content')!
    const readmeState = document.querySelector<HTMLElement>('#readme-state')!
    const readmeBody = document.querySelector<HTMLElement>('#readme-body')!
    const readmeError = document.querySelector<HTMLElement>('#readme-error')!
    const readmeErrorMessage = document.querySelector<HTMLElement>('#readme-error-message')!
    const retryReadme = document.getElementById('retry-readme')
    let readmeLoaded = false
    let readmeLoading = false

    const showReadmeError = (message: string) => {
      readmeState.hidden = true
      readmeBody.hidden = true
      readmeErrorMessage.textContent = message
      readmeError.hidden = false
    }

    const loadReadme = async () => {
      if (readmeLoaded || readmeLoading) return
      readmeLoading = true
      readmeContent.setAttribute('aria-busy', 'true')
      readmeState.hidden = false
      readmeState.textContent = '正在读取 GitHub README...'
      readmeBody.hidden = true
      readmeError.hidden = true

      try {
        const response = await fetch(readmeDisclosure.dataset.readmeApi!, {
          headers: { Accept: 'application/vnd.github.html+json' },
        })
        if (response.status === 404 || response.status === 409) {
          readmeState.textContent = '该仓库暂未提供可读取的 README。'
          readmeLoaded = true
          return
        }
        if (response.status === 403 || response.status === 429) {
          throw new Error('GitHub API 访问频率已达上限，请稍后重试。')
        }
        if (!response.ok) throw new Error('GitHub README 暂时无法读取，请稍后重试。')

        const documentFragment = new DOMParser().parseFromString(await response.text(), 'text/html')
        const wrapper = documentFragment.querySelector('#readme')
        const article = wrapper?.querySelector('article.markdown-body')
        if (!wrapper || !article) throw new Error('GitHub README response did not contain an article')

        const location = {
          fullName: readmeDisclosure.dataset.fullName!,
          defaultBranch: readmeDisclosure.dataset.defaultBranch || 'main',
          readmePath: wrapper.getAttribute('data-path') || 'README.md',
        }
        article.querySelectorAll('a[href]').forEach((link) => {
          const href = link.getAttribute('href')
          if (!href) return
          link.setAttribute('href', resolveReadmeReference(href, location, 'link'))
          if (!href.startsWith('#')) {
            link.setAttribute('target', '_blank')
            link.setAttribute('rel', 'noreferrer')
          }
        })
        article.querySelectorAll('[src]').forEach((media) => {
          const src = media.getAttribute('src')
          if (src) media.setAttribute('src', resolveReadmeReference(src, location, 'media'))
        })

        readmeBody.replaceChildren(...Array.from(article.childNodes).map((node) => document.importNode(node, true)))
        readmeState.hidden = true
        readmeBody.hidden = false
        readmeLoaded = true
      } catch (error) {
        showReadmeError(error instanceof Error ? error.message : 'GitHub README 暂时无法读取，请稍后重试。')
      } finally {
        readmeLoading = false
        readmeContent.setAttribute('aria-busy', 'false')
      }
    }

    readmeDisclosure?.addEventListener('toggle', () => {
      if (readmeDisclosure.open) void loadReadme()
    })
    retryReadme?.addEventListener('click', () => void loadReadme())
  </script>
</BaseLayout>

<style>
  .detail-hero { border-bottom: 1px solid var(--hairline); }
  .detail-hero .container { padding-block: 28px 56px; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--mute); font-size: 13px; }
  .back-link:hover { color: var(--ink); }
  .detail-hero__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.6fr); gap: 80px; align-items: end; padding-top: 56px; }
  .detail-eyebrow, .detail-title, .detail-actions, .detail-metrics dt, .repository-facts dd, .install-heading > span { display: flex; align-items: center; }
  .detail-eyebrow { gap: 9px; }
  .detail-eyebrow > span:last-child { border-left: 1px solid var(--hairline); color: var(--mute); font-size: 12px; padding-left: 10px; }
  .category-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--category-color); }
  .detail-title { min-width: 0; gap: 18px; margin-top: 18px; }
  .detail-title img { width: 56px; height: 56px; flex: 0 0 auto; border-radius: 50%; }
  .detail-title > div { min-width: 0; }
  h1, h2, .detail-title p, .detail-description, .install-section > p, .classification-note, .facts-note { margin: 0; }
  h1 { overflow-wrap: anywhere; font-size: clamp(42px, 6vw, 72px); font-weight: 400; line-height: 1; letter-spacing: 0; }
  .detail-title p { margin-top: 6px; color: var(--mute); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0; }
  .detail-description { max-width: 760px; margin-top: 24px; color: var(--body); font-size: 18px; line-height: 30px; }
  .detail-actions { flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .primary-button { display: inline-flex; min-height: 40px; align-items: center; gap: 8px; border: 1px solid var(--ink); border-radius: 9999px; background: var(--ink); color: var(--canvas); font-size: 14px; padding: 8px 16px; }
  .detail-metrics { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border-block: 1px solid var(--hairline); }
  .detail-metrics div { padding: 18px; }
  .detail-metrics div:nth-child(even) { border-left: 1px solid var(--hairline); }
  .detail-metrics div:nth-child(n + 3) { border-top: 1px solid var(--hairline); }
  .detail-metrics dt { gap: 7px; color: var(--mute); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0; text-transform: uppercase; }
  .detail-metrics dd { margin: 7px 0 0; font-family: var(--font-mono); font-size: 20px; }
  .detail-content { padding-block: 56px 64px; }
  .detail-content__grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 64px; align-items: start; }
  .detail-main { display: grid; min-width: 0; gap: 56px; }
  .detail-section { min-width: 0; border-top: 1px solid var(--hairline); padding-top: 24px; }
  .detail-section h2, .related-heading h2 { margin: 8px 0 24px; font-size: 28px; font-weight: 400; line-height: 36px; }
  .topic-cloud { display: flex; flex-wrap: wrap; gap: 8px; }
  .topic-cloud a { display: inline-flex; min-height: 32px; align-items: center; border: 1px solid var(--outline); border-radius: 9999px; color: var(--body); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0; padding-inline: 12px; transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease; }
  .topic-cloud a:hover { border-color: var(--outline-strong); background: var(--canvas-soft); color: var(--ink); }
  .readme-section { padding-top: 0; }
  .readme-disclosure { border-block: 1px solid var(--hairline); }
  .readme-disclosure summary { display: flex; min-height: 88px; align-items: center; justify-content: space-between; gap: 24px; cursor: pointer; list-style: none; padding-block: 18px; }
  .readme-disclosure summary::-webkit-details-marker { display: none; }
  .readme-heading { display: grid; gap: 6px; }
  .readme-title { display: flex; align-items: center; gap: 9px; font-size: 24px; line-height: 32px; }
  .readme-title svg { color: var(--mute); }
  .readme-toggle { display: inline-flex; min-width: 74px; min-height: 36px; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--outline); border-radius: 9999px; color: var(--body); font-size: 12px; padding-inline: 12px; }
  .readme-toggle svg { transition: transform 160ms ease; }
  .readme-toggle__open { display: none; }
  .readme-disclosure[open] .readme-toggle__closed { display: none; }
  .readme-disclosure[open] .readme-toggle__open { display: inline; }
  .readme-disclosure[open] .readme-toggle svg { transform: rotate(180deg); }
  .readme-content { min-width: 0; overflow: hidden; border-top: 1px solid var(--hairline); padding-block: 28px 40px; }
  .readme-state, .readme-error p { margin: 0; color: var(--mute); font-size: 14px; }
  .readme-error { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .readme-error[hidden] { display: none; }
  .readme-error p { width: 100%; }
  :global(.readme-content .markdown-body) { min-width: 0; color: var(--body); font-size: 15px; line-height: 1.7; overflow-wrap: anywhere; }
  :global(.readme-content .markdown-body > :first-child) { margin-top: 0; }
  :global(.readme-content .markdown-body > :last-child) { margin-bottom: 0; }
  :global(.readme-content .markdown-body h1),
  :global(.readme-content .markdown-body h2),
  :global(.readme-content .markdown-body h3),
  :global(.readme-content .markdown-body h4) { margin: 32px 0 14px; color: var(--ink); font-weight: 500; line-height: 1.3; }
  :global(.readme-content .markdown-body h1) { border-bottom: 1px solid var(--hairline); font-size: 30px; padding-bottom: 12px; }
  :global(.readme-content .markdown-body h2) { border-bottom: 1px solid var(--hairline); font-size: 24px; padding-bottom: 10px; }
  :global(.readme-content .markdown-body h3) { font-size: 20px; }
  :global(.readme-content .markdown-body h4) { font-size: 17px; }
  :global(.readme-content .markdown-body p),
  :global(.readme-content .markdown-body ul),
  :global(.readme-content .markdown-body ol),
  :global(.readme-content .markdown-body blockquote),
  :global(.readme-content .markdown-body pre),
  :global(.readme-content .markdown-body table),
  :global(.readme-content .markdown-body details) { margin: 0 0 18px; }
  :global(.readme-content .markdown-body ul),
  :global(.readme-content .markdown-body ol) { padding-left: 28px; }
  :global(.readme-content .markdown-body li + li) { margin-top: 5px; }
  :global(.readme-content .markdown-body a) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--outline-strong); text-underline-offset: 3px; }
  :global(.readme-content .markdown-body a:hover) { text-decoration-color: currentColor; }
  :global(.readme-content .markdown-body .anchor) { display: none; }
  :global(.readme-content .markdown-body blockquote) { border-left: 3px solid var(--outline-strong); color: var(--mute); padding-left: 16px; }
  :global(.readme-content .markdown-body code) { border-radius: 4px; background: var(--canvas-soft); color: var(--body); font-family: var(--font-mono); font-size: 0.88em; padding: 2px 5px; }
  :global(.readme-content .markdown-body pre) { max-width: 100%; overflow-x: auto; border: 1px solid var(--hairline); border-radius: var(--radius); background: var(--canvas-soft); padding: 16px; }
  :global(.readme-content .markdown-body pre code) { background: transparent; padding: 0; }
  :global(.readme-content .markdown-body markdown-accessiblity-table) { display: block; max-width: 100%; overflow-x: auto; }
  :global(.readme-content .markdown-body table) { width: 100%; border-collapse: collapse; }
  :global(.readme-content .markdown-body th),
  :global(.readme-content .markdown-body td) { border: 1px solid var(--hairline); padding: 8px 10px; text-align: left; }
  :global(.readme-content .markdown-body th) { background: var(--canvas-soft); color: var(--ink); font-weight: 500; }
  :global(.readme-content .markdown-body img),
  :global(.readme-content .markdown-body video) { height: auto; max-width: 100%; }
  :global(.readme-content .markdown-body hr) { height: 1px; margin: 28px 0; border: 0; background: var(--hairline); }
  :global(.readme-content .markdown-body details) { border: 1px solid var(--hairline); border-radius: var(--radius); padding: 12px 14px; }
  :global(.readme-content .markdown-body summary) { cursor: pointer; }
  .classification-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--hairline); }
  .classification-grid div { display: grid; gap: 6px; padding: 16px; }
  .classification-grid div + div { border-left: 1px solid var(--hairline); }
  .classification-grid span { color: var(--mute); font-size: 12px; }
  .classification-grid strong { font-size: 15px; font-weight: 400; }
  .classification-note { margin-top: 18px; color: var(--mute); font-size: 13px; line-height: 22px; }
  .install-heading { display: flex; justify-content: space-between; gap: 24px; align-items: center; }
  .install-heading h2 { margin-bottom: 16px; }
  .install-heading > span { gap: 6px; border: 1px solid rgba(255, 194, 133, 0.35); border-radius: 9999px; color: #ffc285; font-size: 11px; padding: 5px 10px; }
  .command-row { display: flex; width: 100%; min-width: 0; align-items: center; gap: 12px; border: 1px solid var(--hairline); border-radius: var(--radius); background: var(--canvas-soft); padding: 10px 10px 10px 16px; }
  .command-row code { min-width: 0; flex: 1; overflow-x: auto; color: var(--body); font-family: var(--font-mono); font-size: 12px; white-space: nowrap; }
  .check-icon, .is-copied .copy-icon { display: none; }
  .is-copied .check-icon { display: block; }
  .install-section > p { margin-top: 12px; color: var(--mute); font-size: 12px; line-height: 20px; }
