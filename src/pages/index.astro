---
import { Braces, Check, ChevronDown, Copy, ExternalLink, Globe2, Search, Terminal } from '@lucide/astro'

import CatalogPageNav from '../components/CatalogPageNav.astro'
import DeepSeekGridMark from '../components/DeepSeekGridMark.astro'
import ProjectCard from '../components/ProjectCard.astro'
import RankingListItem from '../components/RankingListItem.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { sortCatalogEntries, type Catalog } from '../lib/catalog'
import { catalogData } from '../lib/catalog-data'
import { CATEGORIES, PROJECT_TYPES } from '../lib/classification'
import { buildHomepageStructuredData } from '../lib/seo'
import { RANKING_MODES, sortRankingEntries } from '../lib/ranking'
import { VALIDATION_STATUS_DEFINITIONS } from '../lib/validation'

type CatalogPage = 'directory' | 'verified' | 'ranking'

interface Props {
  catalogPage?: CatalogPage
}

const { catalogPage = 'directory' } = Astro.props
const isDirectoryPage = catalogPage === 'directory'
const isVerifiedPage = catalogPage === 'verified'
const isRankingPage = catalogPage === 'ranking'
const catalog = catalogData as Catalog
const initialCatalog = isVerifiedPage
  ? catalog.repositories.filter((repository) => repository.validation.overall === 'verified')
  : catalog.repositories
const initialRepositories = isRankingPage
  ? []
  : sortCatalogEntries(initialCatalog, 'recommended', catalog.generatedAt).slice(0, 24)
const initialRankingRepositories = isRankingPage
  ? sortRankingEntries(catalog.repositories, 'starsToday').slice(0, 40)
  : []
const initialResultCount = isVerifiedPage ? (catalog.stats.validationStatuses.verified ?? 0) : catalog.stats.fetched
const generatedDate = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date(catalog.generatedAt))
const serializedCatalog = JSON.stringify(catalog.repositories).replace(/</g, '\\u003c')
const serializedCategories = JSON.stringify(CATEGORIES).replace(/</g, '\\u003c')
const serializedTypes = JSON.stringify(PROJECT_TYPES).replace(/</g, '\\u003c')
const serializedValidationStatuses = JSON.stringify(VALIDATION_STATUS_DEFINITIONS).replace(/</g, '\\u003c')
const validationFilterStatuses = [
  ...VALIDATION_STATUS_DEFINITIONS.filter(({ id }) => id === 'verified'),
  ...VALIDATION_STATUS_DEFINITIONS.filter(({ id }) => id !== 'verified'),
]
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`
const storeInstallCommand = 'dsh plugin --profile web add npm:dsh-plugins-store'
const catalogApiUrl = 'api.dshmk.com'
const stableRelayDomain = 'aitreez.com'
const stableRelayUrl = 'https://aitreez.com'
const homepageStructuredData = buildHomepageStructuredData(catalog.stats.fetched)
const pageTitle = isVerifiedPage
  ? '已验证插件 · DSH 插件市场'
  : isRankingPage
    ? '排行榜 · DSH 插件市场'
    : undefined
const pageTitleKey = isVerifiedPage
  ? 'site.pageTitle.verified'
  : isRankingPage
    ? 'site.pageTitle.ranking'
    : 'site.pageTitle.home'
---

<BaseLayout
  title={pageTitle}
  structuredData={isDirectoryPage ? homepageStructuredData : undefined}
  pageTitleKey={pageTitleKey}
>
  <section class="store-install-strip" aria-labelledby="store-install-title">
    <div class="container store-install-strip__inner">
      <div class="store-install-label">
        <Terminal size={16} stroke-width={1.6} />
        <span id="store-install-title" data-i18n="home.installMarket">安装市场插件</span>
      </div>
      <div class="store-install-command">
        <code id="store-install-command" title={storeInstallCommand}>{storeInstallCommand}</code>
        <button
          id="copy-store-install"
          type="button"
          aria-label="复制市场插件安装命令"
          title="复制市场插件安装命令"
          data-i18n-aria-label="home.copyMarketInstall"
          data-i18n-title="home.copyMarketInstall"
        >
          <Copy class="copy-icon" size={16} stroke-width={1.6} />
          <Check class="check-icon" size={16} stroke-width={1.6} />
        </button>
      </div>
      <div class="store-install-label store-api-label">
        <Braces size={16} stroke-width={1.6} />
        <span id="store-api-title" data-i18n="home.catalogApi">调用市场 API</span>
      </div>
      <div class="store-install-command store-api-command" role="group" aria-labelledby="store-api-title">
        <code id="catalog-api-url" title={catalogApiUrl}>{catalogApiUrl}</code>
        <button
          id="copy-catalog-api"
          type="button"
          aria-label="复制市场 API 地址"
          title="复制市场 API 地址"
          data-i18n-aria-label="home.copyCatalogApi"
          data-i18n-title="home.copyCatalogApi"
        >
          <Copy class="copy-icon" size={16} stroke-width={1.6} />
          <Check class="check-icon" size={16} stroke-width={1.6} />
        </button>
      </div>
      <div class="store-install-label stable-relay-label">
        <Globe2 size={16} stroke-width={1.6} />
        <span id="stable-relay-title" data-i18n="home.stableRelay">稳定中转站</span>
      </div>
      <div class="store-install-command stable-relay-command" role="group" aria-labelledby="stable-relay-title">
        <code id="stable-relay-domain" title={stableRelayDomain}>{stableRelayDomain}</code>
        <button
          id="copy-stable-relay"
          type="button"
          aria-label="复制稳定中转站域名"
          title="复制稳定中转站域名"
          data-i18n-aria-label="home.copyStableRelay"
          data-i18n-title="home.copyStableRelay"
        >
          <Copy class="copy-icon" size={16} stroke-width={1.6} />
          <Check class="check-icon" size={16} stroke-width={1.6} />
        </button>
        <a
          id="open-stable-relay"
          href={stableRelayUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="打开稳定中转站"
          title="打开稳定中转站"
          data-i18n-aria-label="home.openStableRelay"
          data-i18n-title="home.openStableRelay"
        >
          <ExternalLink size={16} stroke-width={1.6} />
        </a>
      </div>
      <span id="store-install-status" class="visually-hidden" aria-live="polite"></span>
    </div>
  </section>

  <section class="catalog-head" data-catalog-head>
    <div class="catalog-head__art" aria-hidden="true">
      <DeepSeekGridMark class="catalog-head__grid-mark--base" gradientId="deepseek-grid-base" opacity={0.88} />
      <span class="catalog-head__art-focus">
        <DeepSeekGridMark class="catalog-head__grid-mark--focus" gradientId="deepseek-grid-focus" />
      </span>
    </div>
    <div class="container catalog-head__inner">
      <div class="catalog-head__title">
        <p class="mono-label">DSH-PLUGIN STORE / LIVE CATALOG</p>
        <h1 data-i18n="home.heroTitle">DSH 插件市场</h1>
        <p>
          <span data-i18n="home.heroLine1">每 30 分钟自动同步并验证 GitHub 社区项目。</span>
          <span data-i18n="home.heroLine2">为 DSH 生态维护一个持续更新、可检索的插件目录。</span>
        </p>
      </div>

      <dl class="catalog-stats" aria-label="目录统计" data-i18n-aria-label="home.stats">
        <div>
          <dt data-i18n="home.listed">已收录</dt>
          <dd>{catalog.stats.fetched}</dd>
        </div>
        <div>
          <dt data-i18n="home.categories">功能分类</dt>
          <dd>{CATEGORIES.length}</dd>
        </div>
        <div>
          <dt data-i18n="home.updated">更新时间</dt>
          <dd data-i18n-date={catalog.generatedAt} data-i18n-date-time>{generatedDate}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="catalog-tools" aria-label="目录筛选" data-i18n-aria-label="home.filters">
    <div class="container">
      <div class="search-row">
        <label class="search-field">
          <span class="visually-hidden" data-i18n="home.search">搜索项目</span>
          <Search size={19} stroke-width={1.6} />
          <input
            id="catalog-search"
            type="search"
            placeholder="搜索名称、作者、描述或标签"
            data-i18n-placeholder="home.searchPlaceholder"
            autocomplete="off"
          />
        </label>

        <CatalogPageNav active={catalogPage} baseUrl={baseUrl} />
      </div>

      <div class="category-filter-panel" data-category-filter-panel>
          <div class="filter-groups" id="classification-filter-groups">
            <div class="filter-group" data-filter-group="type">
              <span class="filter-group__title" id="type-filter-label" data-i18n="home.projectType">项目类型</span>
              <div class="filter-group__options" id="type-filter" role="group" aria-labelledby="type-filter-label">
                <button class="category-filter is-active" type="button" data-type="all" aria-pressed="true">
                  <span class="category-filter__label" data-i18n="home.allTypes">全部类型</span>
                  <span class="category-filter__count">{catalog.stats.fetched}</span>
                </button>
                {PROJECT_TYPES.map((type) => (
                  <button class="category-filter" type="button" data-type={type.id} aria-pressed="false">
                    <span class="category-filter__label" data-i18n={`projectType.${type.id}`}>{type.label}</span>
                    <span class="category-filter__count">{catalog.stats.projectTypes[type.id] ?? 0}</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="filter-group" data-filter-group="category">
              <span class="filter-group__title" id="category-filter-label" data-i18n="home.category">功能分类</span>
              <div class="filter-group__options" id="category-filter" role="group" aria-labelledby="category-filter-label">
                <button class="category-filter is-active" type="button" data-category="all" aria-pressed="true">
                  <span class="category-filter__label" data-i18n="home.all">全部</span>
                  <span class="category-filter__count">{catalog.stats.fetched}</span>
                </button>
                {CATEGORIES.map((category) => (
                  <button class="category-filter" type="button" data-category={category.id} aria-pressed="false">
                    <i style={`--category-color: ${category.color}`}></i>
                    <span class="category-filter__label" data-i18n={`category.${category.id}`}>{category.label}</span>
                    <span class="category-filter__count">{catalog.stats.categories[category.id] ?? 0}</span>
                  </button>
                ))}
              </div>
            </div>

            {isRankingPage && (
              <div class="filter-group" data-filter-group="ranking">
                <span class="filter-group__title" id="ranking-filter-label" data-i18n="ranking.dimension">榜单维度</span>
                <div class="filter-group__options" id="ranking-filter" role="group" aria-labelledby="ranking-filter-label">
                  {RANKING_MODES.map((mode, index) => (
                    <button
                      class:list={{ 'category-filter': true, 'is-active': index === 0 }}
                      type="button"
                      data-ranking-mode={mode.id}
                      aria-pressed={index === 0}
                    >
                      <span class="category-filter__label" data-i18n={`ranking.mode.${mode.id}`}>{mode.label}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {isVerifiedPage && (
              <div class="filter-group" data-filter-group="validation">
                <span class="filter-group__title" id="validation-filter-label" data-i18n="home.validation">验证状态</span>
                <div class="filter-group__options" id="validation-filter" role="group" aria-labelledby="validation-filter-label">
                  <button class="category-filter" type="button" data-validation="all" aria-pressed="false">
                    <span class="category-filter__label" data-i18n="home.allValidation">全部验证状态</span>
                    <span class="category-filter__count">{catalog.stats.fetched}</span>
                  </button>
                  {validationFilterStatuses.map((status) => (
                    <button
                      class:list={{ 'category-filter': true, 'is-active': status.id === 'verified' }}
                      type="button"
                      data-validation={status.id}
                      aria-pressed={status.id === 'verified'}
                    >
                      <span class="category-filter__label" data-i18n={`validation.status.${status.id}`}>{status.label}</span>
                      <span class="category-filter__count">{catalog.stats.validationStatuses[status.id] ?? 0}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>
          <button
            id="category-filter-toggle"
            class="category-filter-toggle"
            type="button"
            aria-controls="classification-filter-groups"
            aria-expanded="false"
            aria-label="展开全部分类"
            title="展开全部分类"
            data-i18n-aria-label="home.expandCategories"
            data-i18n-title="home.expandCategories"
          >
            <ChevronDown size={17} stroke-width={1.8} aria-hidden="true" />
          </button>
      </div>
    </div>
  </section>

  {isRankingPage && (
    <section class="catalog-results" id="ranking-content">
      <div class="container">
        <div class="results-head">
          <p id="ranking-result-count">{catalog.stats.fetched} 个项目</p>
          <p><i></i> <span data-i18n="ranking.snapshotNote">每 30 分钟刷新 · 每日 00:00（北京时间）重新计数</span></p>
        </div>

        <ol class="ranking-list" id="ranking-list" aria-label="插件排行榜" data-i18n-aria-label="ranking.listLabel">
          {initialRankingRepositories.map((repository, index) => (
            <RankingListItem repository={repository} rank={index + 1} mode="starsToday" />
          ))}
        </ol>

        <template id="ranking-row-template">
          <RankingListItem repository={catalog.repositories[0]} rank={1} mode="starsToday" />
        </template>

        <div class="empty-state" id="ranking-empty-state" hidden>
          <p class="mono-label">NO MATCHES</p>
          <h2 data-i18n="home.emptyTitle">没有找到匹配项目</h2>
          <p data-i18n="home.emptyBody">当前筛选条件下没有结果。</p>
          <button class="outline-button" id="ranking-clear-filters" type="button" data-i18n="home.clearFilters">清除筛选</button>
        </div>

        <div class="load-row">
          <button class="outline-button" id="ranking-load-more" type="button">
            <span data-i18n="home.loadMore">加载更多</span>
            <span id="ranking-remaining-count">{Math.max(0, catalog.stats.fetched - initialRankingRepositories.length)}</span>
          </button>
        </div>
      </div>
    </section>
  )}

  {!isRankingPage && (
    <section class="catalog-results">
      <div class="container">
        <div class="results-head">
          <p id="result-count">{initialResultCount} 个项目</p>
          <p><i></i> <span data-i18n="home.synced">标识随目录同步刷新</span></p>
        </div>

        <div class="project-grid" id="project-grid">
          {initialRepositories.map((repository) => <ProjectCard repository={repository} />)}
        </div>

        <template id="project-card-template">
          <ProjectCard repository={catalog.repositories[0]} />
        </template>

        <div class="empty-state" id="empty-state" hidden>
          <p class="mono-label">NO MATCHES</p>
          <h2 data-i18n="home.emptyTitle">没有找到匹配项目</h2>
          <p data-i18n="home.emptyBody">当前筛选条件下没有结果。</p>
          <button class="outline-button" id="clear-filters" type="button" data-i18n="home.clearFilters">清除筛选</button>
        </div>

        <div class="load-row">
          <button class="outline-button" id="load-more" type="button">
            <span data-i18n="home.loadMore">加载更多</span>
            <span id="remaining-count">{Math.max(0, initialResultCount - initialRepositories.length)}</span>
          </button>
        </div>
      </div>
    </section>
  )}

  <script id="catalog-data" type="application/json" set:html={serializedCatalog} is:inline></script>
  <script id="catalog-generated-at" type="application/json" set:html={JSON.stringify(catalog.generatedAt)} is:inline></script>
  <script id="category-data" type="application/json" set:html={serializedCategories} is:inline></script>
  <script id="type-data" type="application/json" set:html={serializedTypes} is:inline></script>
  <script id="validation-status-data" type="application/json" set:html={serializedValidationStatuses} is:inline></script>
  <script id="catalog-page-data" type="application/json" set:html={JSON.stringify(catalogPage)} is:inline></script>
  <script id="base-url" type="application/json" set:html={JSON.stringify(baseUrl)} is:inline></script>

  <script>
    import { getHeroMotion } from '../lib/hero-motion'

    const translate = (key: string) => window.dshI18n?.t(key) ?? key

    const storeInstallCommand = document.getElementById('store-install-command')
    const copyStoreInstall = document.getElementById('copy-store-install')
    const catalogApiUrl = document.getElementById('catalog-api-url')
    const copyCatalogApi = document.getElementById('copy-catalog-api')
    const stableRelayDomain = document.getElementById('stable-relay-domain')
    const copyStableRelay = document.getElementById('copy-stable-relay')
    const storeInstallStatus = document.getElementById('store-install-status')

    const bindCopyFeedback = (
      source: HTMLElement | null,
      button: HTMLElement | null,
      copyLabelKey: string,
      copiedLabelKey: string,
    ) => {
      if (!source || !button || !storeInstallStatus) return

      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(source.textContent ?? '')
        button.classList.add('is-copied')
        const copiedLabel = translate(copiedLabelKey)
        button.setAttribute('aria-label', copiedLabel)
        button.setAttribute('title', copiedLabel)
        storeInstallStatus.textContent = copiedLabel
        window.setTimeout(() => {
          button.classList.remove('is-copied')
          const copyLabel = translate(copyLabelKey)
          button.setAttribute('aria-label', copyLabel)
          button.setAttribute('title', copyLabel)
          storeInstallStatus.textContent = ''
        }, 1600)
      })
    }

    bindCopyFeedback(
      storeInstallCommand,
      copyStoreInstall,
      'home.copyMarketInstall',
      'home.installCopied',
    )
    bindCopyFeedback(
      catalogApiUrl,
      copyCatalogApi,
      'home.copyCatalogApi',
      'home.catalogApiCopied',
    )
    bindCopyFeedback(
      stableRelayDomain,
      copyStableRelay,
      'home.copyStableRelay',
      'home.stableRelayCopied',
    )

    const catalogHead = document.querySelector<HTMLElement>('[data-catalog-head]')
    const supportsMotion = window.matchMedia('(pointer: fine)').matches
      && !window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (catalogHead && supportsMotion) {
      let animationFrame = 0

      catalogHead.addEventListener('pointermove', (event) => {
        cancelAnimationFrame(animationFrame)
        const motion = getHeroMotion(event.clientX, event.clientY, catalogHead.getBoundingClientRect())

        animationFrame = requestAnimationFrame(() => {
          catalogHead.style.setProperty('--hero-mark-x', `${motion.offsetX}px`)
          catalogHead.style.setProperty('--hero-mark-y', `${motion.offsetY}px`)
          catalogHead.style.setProperty('--hero-light-x', `${motion.lightX}%`)
          catalogHead.style.setProperty('--hero-light-y', `${motion.lightY}%`)
        })
      })

      catalogHead.addEventListener('pointerleave', () => {
        cancelAnimationFrame(animationFrame)
        catalogHead.style.removeProperty('--hero-mark-x')
        catalogHead.style.removeProperty('--hero-mark-y')
        catalogHead.style.removeProperty('--hero-light-x')
        catalogHead.style.removeProperty('--hero-light-y')
      })
    }
  </script>

  {!isRankingPage && (
    <script is:inline>
    {
    const repositories = JSON.parse(document.getElementById('catalog-data').textContent)
    const recommendationSeed = JSON.parse(document.getElementById('catalog-generated-at').textContent)
    const categories = JSON.parse(document.getElementById('category-data').textContent)
    const projectTypes = JSON.parse(document.getElementById('type-data').textContent)
    const validationStatuses = JSON.parse(document.getElementById('validation-status-data').textContent)
    const catalogPage = JSON.parse(document.getElementById('catalog-page-data').textContent)
    const isVerifiedPage = catalogPage === 'verified'
    const baseUrl = JSON.parse(document.getElementById('base-url').textContent)
    const categoryById = new Map(categories.map((category) => [category.id, category]))
    const typeById = new Map(projectTypes.map((type) => [type.id, type]))
    const validationStatusIds = new Set(validationStatuses.map((status) => status.id))
    const grid = document.getElementById('project-grid')
    const sourceCard = document.getElementById('project-card-template').content
      .querySelector('[data-project-card]').cloneNode(true)
    const searchInput = document.getElementById('catalog-search')
    const typeFilter = document.getElementById('type-filter')
    const categoryFilter = document.getElementById('category-filter')
    const validationFilter = document.getElementById('validation-filter')
    const categoryFilterPanel = document.querySelector('[data-category-filter-panel]')
    const categoryFilterToggle = document.getElementById('category-filter-toggle')
    const resultCount = document.getElementById('result-count')
    const loadMore = document.getElementById('load-more')
    const remainingCount = document.getElementById('remaining-count')
    const emptyState = document.getElementById('empty-state')
    const clearFilters = document.getElementById('clear-filters')
    const pageSize = 24
    const catalogFilterParamNames = ['q', 'category', 'type', 'validation']
    let selectedValidation = isVerifiedPage ? 'verified' : 'all'
    let selectedType = 'all'
    let selectedCategory = 'all'
    let visibleCount = pageSize

    const t = (key, params = {}, fallback = key) => window.dshI18n?.t(key, params) ?? fallback

    const createSeededRandom = (seed) => {
      let state = 2166136261
      for (let index = 0; index < seed.length; index += 1) {
        state = Math.imul(state ^ seed.charCodeAt(index), 16777619)
      }
      return () => {
        state = (Math.imul(state, 1664525) + 1013904223) >>> 0
        return state / 4294967296
      }
    }

    const mixRecommendedRepositories = (priority, discovery, random) => {
      const mixed = []
      let priorityIndex = 0
      let discoveryIndex = 0

      while (priorityIndex < priority.length || discoveryIndex < discovery.length) {
        const priorityCount = Math.min(2, priority.length - priorityIndex)
        const hasDiscovery = discoveryIndex < discovery.length
        if (!hasDiscovery) {
          mixed.push(...priority.slice(priorityIndex, priorityIndex + priorityCount))
          priorityIndex += priorityCount
          continue
        }

        const discoveryPosition = Math.floor(random() * (priorityCount + 1))
        for (let slot = 0; slot <= priorityCount; slot += 1) {
          if (slot === discoveryPosition) {
            mixed.push(discovery[discoveryIndex])
            discoveryIndex += 1
          } else {
            mixed.push(priority[priorityIndex])
            priorityIndex += 1
          }
        }
      }

      return mixed
    }

    const getCatalogFilterParams = () => {
      const params = new URLSearchParams()
      const query = searchInput.value.trim()
      if (query) params.set('q', query)
      if (selectedCategory !== 'all') params.set('category', selectedCategory)
      if (selectedType !== 'all') params.set('type', selectedType)
      if (isVerifiedPage && selectedValidation !== 'verified') params.set('validation', selectedValidation)
      return params
    }

    const getCatalogDetailSearch = () => {
      const params = getCatalogFilterParams()
      if (isVerifiedPage) params.set('from', 'verified')
      const search = params.toString()
      return search ? `?${search}` : ''
    }

    const syncFiltersToUrl = () => {
      const url = new URL(window.location.href)
      catalogFilterParamNames.forEach((param) => url.searchParams.delete(param))
      getCatalogFilterParams().forEach((value, param) => url.searchParams.set(param, value))
      window.history.replaceState(window.history.state, '', `${url.pathname}${url.search}${url.hash}`)
    }

    const compactNumber = (value) => {
      if (value < 1000) return String(value)
      if (value < 1000000) return `${(value / 1000).toFixed(1).replace(/\.0$/, '')}k`
      return `${(value / 1000000).toFixed(1).replace(/\.0$/, '')}m`
    }

    const relativeDate = (value) => {
      if (window.dshI18n) return window.dshI18n.relativeDate(value)
      const date = new Date(value)
      if (Number.isNaN(date.getTime())) return '未知'
      const days = Math.max(0, Math.floor((Date.now() - date.getTime()) / 86400000))
      if (days === 0) return '今天'
      if (days < 30) return `${days} 天前`
      if (days < 365) return `${Math.floor(days / 30)} 个月前`
      return `${Math.floor(days / 365)} 年前`
    }

    const setText = (card, selector, value) => {
      const target = card.querySelector(selector)
      if (target) target.textContent = value
    }

    const createCard = (repository) => {
      const card = sourceCard.cloneNode(true)
      const category = categoryById.get(repository.category)
      const projectType = typeById.get(repository.projectType)
      const detailSearch = getCatalogDetailSearch()
      const detailUrl = `${baseUrl}plugins/${repository.slug}${detailSearch}`
      const searchable = [
        repository.name,
        repository.fullName,
        repository.description,
        repository.language || '',
        ...repository.topics,
      ].join(' ').toLocaleLowerCase('zh-CN')

      card.dataset.search = searchable
      card.dataset.category = repository.category
      card.dataset.type = repository.projectType
      card.dataset.validationStatus = repository.validation.overall
      card.dataset.stars = String(repository.stars)
      card.dataset.updated = repository.pushedAt
      card.querySelector('[data-field="category-dot"]').style.setProperty('--category-color', category.color)
      const categoryLabel = card.querySelector('[data-field="category"]')
      categoryLabel.dataset.i18n = `category.${repository.category}`
      setText(card, '[data-field="category"]', t(categoryLabel.dataset.i18n, {}, category.label))
      const projectTypeLabel = card.querySelector('[data-field="project-type"]')
      projectTypeLabel.dataset.i18n = `projectType.${repository.projectType}`
      setText(card, '[data-field="project-type"]', t(projectTypeLabel.dataset.i18n, {}, projectType.label))
      const validationLabel = card.querySelector('[data-field="validation-label"]')
      validationLabel.dataset.i18n = `validation.status.${repository.validation.overall}`
      setText(card, '[data-field="validation-label"]', t(validationLabel.dataset.i18n, {}, repository.validation.label))
      setText(card, '[data-field="owner"]', repository.owner.login)
      setText(card, '[data-field="description"]', repository.description)
      setText(card, '[data-field="stars"]', compactNumber(repository.stars))
      setText(card, '[data-field="forks"]', compactNumber(repository.forks))
      setText(card, '[data-field="issues"]', compactNumber(repository.openIssues))
      const updated = card.querySelector('[data-field="updated"]')
      updated.dataset.i18nRelativeDate = repository.pushedAt
      setText(card, '[data-field="updated"]', relativeDate(repository.pushedAt))

      const avatar = card.querySelector('[data-field="avatar"]')
      avatar.src = repository.owner.avatarUrl
      avatar.alt = ''
      const detailLink = card.querySelector('[data-field="detail-link"]')
      detailLink.href = detailUrl
      detailLink.textContent = repository.name
      const openLink = card.querySelector('[data-field="open-link"]')
      openLink.href = detailUrl
      openLink.dataset.i18nAriaLabel = 'card.openDetails'
      openLink.dataset.i18nParamName = repository.name
      openLink.setAttribute('aria-label', t('card.openDetails', { name: repository.name }, `查看 ${repository.name} 详情`))

      const validation = card.querySelector('[data-field="validation"]')
      validation.dataset.tone = repository.validation.tone
      validation.dataset.i18nValidationTitle = repository.validation.overall
      validation.title = t('card.validationTitle', {
        status: t(`validation.status.${repository.validation.overall}`, {}, repository.validation.label),
      }, `验证状态：${repository.validation.label}`)
      validation.querySelectorAll('[data-validation-step]').forEach((step) => {
        step.dataset.status = repository.validation.stages[step.dataset.validationStep].status
      })

      const topicList = card.querySelector('[data-field="topics"]')
      const sourceTopic = topicList.querySelector('span')
      topicList.replaceChildren(...repository.topics.slice(0, 4).map((topic) => {
        const item = sourceTopic.cloneNode(true)
        item.textContent = topic
        return item
      }))
      window.dshI18n?.translate(card)
      return card
    }

    const getFilteredRepositories = () => {
      const query = searchInput.value.trim().toLocaleLowerCase('zh-CN')
      const filtered = repositories.filter((repository) => {
        const searchable = [
          repository.name,
          repository.fullName,
          repository.description,
          repository.language || '',
          ...repository.topics,
        ].join(' ').toLocaleLowerCase('zh-CN')
        return (!query || searchable.includes(query))
          && (selectedCategory === 'all' || repository.category === selectedCategory)
          && (selectedType === 'all' || repository.projectType === selectedType)
          && (!isVerifiedPage || selectedValidation === 'all' || repository.validation.overall === selectedValidation)
      })

      const compareStatus = (left, right) => {
        const verifiedPriority = Number(right.verified) - Number(left.verified)
        return verifiedPriority
      }
      const compareStars = (left, right) => (
        right.stars - left.stars
        || compareStatus(left, right)
        || left.fullName.localeCompare(right.fullName)
      )

      const priority = filtered
        .filter((repository) => repository.verified)
        .sort(compareStars)
      const discovery = filtered
        .filter((repository) => !repository.verified)
        .sort(compareStars)
      return mixRecommendedRepositories(priority, discovery, createSeededRandom(recommendationSeed))
    }

    const render = () => {
      const filtered = getFilteredRepositories()
      const visible = filtered.slice(0, visibleCount)
      grid.replaceChildren(...visible.map(createCard))
      resultCount.textContent = t('home.projectCount', { count: filtered.length }, `${filtered.length} 个项目`)
      emptyState.hidden = filtered.length !== 0
      grid.hidden = filtered.length === 0
      const remaining = Math.max(0, filtered.length - visible.length)
      loadMore.hidden = remaining === 0
      remainingCount.textContent = String(remaining)
    }

    const resetAndRender = () => {
      visibleCount = pageSize
      render()
    }

    const commitFilters = () => {
      syncFiltersToUrl()
      resetAndRender()
    }

    const syncValidationFilters = () => {
      validationFilter?.querySelectorAll('[data-validation]').forEach((item) => {
        const isActive = item.dataset.validation === selectedValidation
        item.classList.toggle('is-active', isActive)
        item.setAttribute('aria-pressed', String(isActive))
      })
    }

    const setCategoryExpanded = (expanded) => {
      if (!categoryFilterPanel || !categoryFilterToggle) return
      categoryFilterPanel.classList.add('is-collapsible')
      categoryFilterPanel.classList.toggle('is-expanded', expanded)
      categoryFilterToggle.setAttribute('aria-expanded', String(expanded))
      const labelKey = expanded ? 'home.collapseCategories' : 'home.expandCategories'
      const fallback = expanded ? '收起全部分类' : '展开全部分类'
      const label = t(labelKey, {}, fallback)
      categoryFilterToggle.dataset.i18nAriaLabel = labelKey
      categoryFilterToggle.dataset.i18nTitle = labelKey
      categoryFilterToggle.setAttribute('aria-label', label)
      categoryFilterToggle.setAttribute('title', label)
    }

    setCategoryExpanded(false)
    categoryFilterToggle?.addEventListener('click', () => {
      setCategoryExpanded(categoryFilterToggle.getAttribute('aria-expanded') !== 'true')
    })

    const restoreFiltersFromUrl = () => {
      const filters = new URLSearchParams(window.location.search)
      const requestedCategory = filters.get('category')
      const requestedType = filters.get('type')
      const requestedValidation = filters.get('validation')

      searchInput.value = filters.get('q') ?? ''
      selectedValidation = isVerifiedPage
        && (requestedValidation === 'all' || validationStatusIds.has(requestedValidation))
        ? requestedValidation
        : isVerifiedPage ? 'verified' : 'all'
      selectedCategory = categoryById.has(requestedCategory) ? requestedCategory : 'all'
      selectedType = typeById.has(requestedType) ? requestedType : 'all'

      syncValidationFilters()
      typeFilter.querySelectorAll('[data-type]').forEach((item) => {
        const isActive = item.dataset.type === selectedType
        item.classList.toggle('is-active', isActive)
        item.setAttribute('aria-pressed', String(isActive))
      })
      categoryFilter.querySelectorAll('[data-category]').forEach((item) => {
        const isActive = item.dataset.category === selectedCategory
        item.classList.toggle('is-active', isActive)
        item.setAttribute('aria-pressed', String(isActive))
      })
      if (selectedType !== 'all' || selectedCategory !== 'all' || (isVerifiedPage && selectedValidation !== 'verified')) {
        setCategoryExpanded(true)
      }
    }

    searchInput.addEventListener('input', commitFilters)
    typeFilter.addEventListener('click', (event) => {
      const button = event.target.closest('[data-type]')
      if (!button) return
      selectedType = button.dataset.type
      typeFilter.querySelectorAll('[data-type]').forEach((item) => {
        const isActive = item === button
        item.classList.toggle('is-active', isActive)
        item.setAttribute('aria-pressed', String(isActive))
      })
      commitFilters()
    })
    categoryFilter.addEventListener('click', (event) => {
      const button = event.target.closest('[data-category]')
      if (!button) return
      selectedCategory = button.dataset.category
      categoryFilter.querySelectorAll('[data-category]').forEach((item) => {
        const isActive = item === button
        item.classList.toggle('is-active', isActive)
        item.setAttribute('aria-pressed', String(isActive))
      })
      commitFilters()
    })
    validationFilter?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-validation]')
      if (!button) return
      selectedValidation = button.dataset.validation
      syncValidationFilters()
      commitFilters()
    })
    loadMore.addEventListener('click', () => {
      visibleCount += pageSize
      render()
    })
    clearFilters.addEventListener('click', () => {
      searchInput.value = ''
      selectedValidation = isVerifiedPage ? 'verified' : 'all'
      selectedType = 'all'
      selectedCategory = 'all'
      syncValidationFilters()
      typeFilter.querySelectorAll('[data-type]').forEach((item) => {
        const isActive = item.dataset.type === 'all'
        item.classList.toggle('is-active', isActive)
        item.setAttribute('aria-pressed', String(isActive))
      })
      categoryFilter.querySelectorAll('[data-category]').forEach((item) => {
        const isActive = item.dataset.category === 'all'
        item.classList.toggle('is-active', isActive)
        item.setAttribute('aria-pressed', String(isActive))
      })
      commitFilters()
      searchInput.focus()
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== searchInput) {
        event.preventDefault()
        searchInput.focus()
      }
      if (event.key === 'Escape' && document.activeElement === searchInput) {
        searchInput.value = ''
        searchInput.blur()
        commitFilters()
      }
    })
    document.addEventListener('dsh:locale-change', () => {
      render()
    })
    restoreFiltersFromUrl()
    resetAndRender()
    }
    </script>
  )}

  {isRankingPage && (
    <script is:inline>
    {
    const repositories = JSON.parse(document.getElementById('catalog-data').textContent)
    const categories = JSON.parse(document.getElementById('category-data').textContent)
    const projectTypes = JSON.parse(document.getElementById('type-data').textContent)
    const baseUrl = JSON.parse(document.getElementById('base-url').textContent)
    const categoryById = new Map(categories.map((category) => [category.id, category]))
    const typeById = new Map(projectTypes.map((type) => [type.id, type]))
    const rankingModeIds = new Set(['starsToday', 'stars', 'newest', 'updated'])
    const list = document.getElementById('ranking-list')
    const sourceRow = document.getElementById('ranking-row-template').content
      .querySelector('[data-ranking-row]').cloneNode(true)
    const searchInput = document.getElementById('catalog-search')
    const typeFilter = document.getElementById('type-filter')
    const categoryFilter = document.getElementById('category-filter')
    const rankingFilter = document.getElementById('ranking-filter')
    const categoryFilterPanel = document.querySelector('[data-category-filter-panel]')
    const categoryFilterToggle = document.getElementById('category-filter-toggle')
    const resultCount = document.getElementById('ranking-result-count')
    const loadMore = document.getElementById('ranking-load-more')
    const remainingCount = document.getElementById('ranking-remaining-count')
    const emptyState = document.getElementById('ranking-empty-state')
    const clearFilters = document.getElementById('ranking-clear-filters')
    const pageSize = 40
    const rankingParamNames = ['q', 'category', 'type', 'rank']
    let selectedRankingMode = 'starsToday'
    let selectedType = 'all'
    let selectedCategory = 'all'
    let visibleCount = pageSize

    const t = (key, params = {}, fallback = key) => window.dshI18n?.t(key, params) ?? fallback

    const compactNumber = (value) => {
      if (value < 1000) return String(value)
      if (value < 1000000) return `${(value / 1000).toFixed(1).replace(/\.0$/, '')}k`
      return `${(value / 1000000).toFixed(1).replace(/\.0$/, '')}m`
    }

    const relativeDate = (value) => window.dshI18n?.relativeDate(value) ?? '未知'

    const buildSparkline = (points, width = 96, height = 28, padding = 2) => {
      if (points.length === 0) return ''
      if (points.length === 1) return `${padding},${height / 2} ${width - padding},${height / 2}`
      const timestamps = points.map(({ capturedAt }) => Date.parse(capturedAt))
      const stars = points.map((point) => point.stars)
      const minTime = Math.min(...timestamps)
      const maxTime = Math.max(...timestamps)
      const minStars = Math.min(...stars)
      const maxStars = Math.max(...stars)
      const usableWidth = width - padding * 2
      const usableHeight = height - padding * 2
      return points.map((point, index) => {
        const x = maxTime === minTime
          ? padding + usableWidth * index / (points.length - 1)
          : padding + usableWidth * (timestamps[index] - minTime) / (maxTime - minTime)
        const y = maxStars === minStars
          ? height / 2
          : padding + usableHeight * (maxStars - point.stars) / (maxStars - minStars)
        return `${Number(x.toFixed(1))},${Number(y.toFixed(1))}`
      }).join(' ')
    }

    const getRankingParams = () => {
      const params = new URLSearchParams()
      const query = searchInput.value.trim()
      if (query) params.set('q', query)
      if (selectedCategory !== 'all') params.set('category', selectedCategory)
      if (selectedType !== 'all') params.set('type', selectedType)
      if (selectedRankingMode !== 'starsToday') params.set('rank', selectedRankingMode)
      return params
    }

    const getRankingDetailSearch = () => {
      const params = getRankingParams()
      params.set('rank', selectedRankingMode)
      params.set('from', 'ranking')
      return `?${params.toString()}`
    }

    const syncFiltersToUrl = () => {
      const url = new URL(window.location.href)
      rankingParamNames.forEach((param) => url.searchParams.delete(param))
      getRankingParams().forEach((value, param) => url.searchParams.set(param, value))
      window.history.replaceState(window.history.state, '', `${url.pathname}${url.search}${url.hash}`)
    }

    const setText = (row, selector, value) => {
      const target = row.querySelector(selector)
      if (target) target.textContent = value
    }

    const createRow = (repository, rank) => {
      const row = sourceRow.cloneNode(true)
      const category = categoryById.get(repository.category)
      const projectType = typeById.get(repository.projectType)
      const detailUrl = `${baseUrl}plugins/${repository.slug}${getRankingDetailSearch()}`
      const changeToday = repository.starTrend.changeToday

      row.dataset.mode = selectedRankingMode
      row.dataset.category = repository.category
      row.dataset.type = repository.projectType
      setText(row, '[data-field="rank"]', String(rank).padStart(2, '0'))
      setText(row, '[data-field="owner"]', repository.owner.login)
      setText(row, '[data-field="total-stars"]', compactNumber(repository.stars))

      const avatar = row.querySelector('[data-field="avatar"]')
      avatar.src = repository.owner.avatarUrl
      avatar.alt = ''
      const detailLink = row.querySelector('[data-field="detail-link"]')
      detailLink.href = detailUrl
      detailLink.textContent = repository.name
      const openLink = row.querySelector('[data-field="open-link"]')
      openLink.href = detailUrl
      openLink.dataset.i18nAriaLabel = 'card.openDetails'
      openLink.dataset.i18nParamName = repository.name
      openLink.setAttribute('aria-label', t('card.openDetails', { name: repository.name }, `查看 ${repository.name} 详情`))

      const categoryLabel = row.querySelector('[data-field="category"]')
      categoryLabel.dataset.i18n = `category.${repository.category}`
      categoryLabel.textContent = t(categoryLabel.dataset.i18n, {}, category?.label ?? repository.category)
      const projectTypeLabel = row.querySelector('[data-field="project-type"]')
      projectTypeLabel.dataset.i18n = `projectType.${repository.projectType}`
      projectTypeLabel.textContent = t(projectTypeLabel.dataset.i18n, {}, projectType?.label ?? repository.projectType)

      const metricLabel = row.querySelector('[data-field="metric-label"]')
      const metricValue = row.querySelector('[data-field="star-change"], [data-field="metric-value"]')
      const sparklineWrap = row.querySelector('[data-field="sparkline-wrap"]')
      const sparkline = row.querySelector('[data-field="sparkline"]')
      metricValue.removeAttribute('data-i18n')
      metricValue.removeAttribute('data-i18n-relative-date')

      if (selectedRankingMode === 'starsToday') {
        metricLabel.dataset.i18n = 'ranking.metric.starsToday'
        metricLabel.textContent = t('ranking.metric.starsToday', {}, '今日增长')
        metricValue.dataset.field = 'star-change'
        metricValue.textContent = `${changeToday >= 0 ? '+' : ''}${compactNumber(changeToday)}`
        sparklineWrap.hidden = false
        sparkline.setAttribute('points', buildSparkline(repository.starTrend?.points ?? []))
      } else if (selectedRankingMode === 'stars') {
        metricLabel.dataset.i18n = 'ranking.metric.stars'
        metricLabel.textContent = t('ranking.metric.stars', {}, 'Star 数')
        metricValue.dataset.field = 'metric-value'
        metricValue.textContent = compactNumber(repository.stars)
        sparklineWrap.hidden = true
      } else {
        const date = selectedRankingMode === 'newest' ? repository.createdAt : repository.pushedAt
        const metricKey = selectedRankingMode === 'newest' ? 'ranking.metric.newest' : 'ranking.metric.updated'
        metricLabel.dataset.i18n = metricKey
        metricLabel.textContent = t(metricKey, {}, selectedRankingMode === 'newest' ? '发布于' : '更新于')
        metricValue.dataset.field = 'metric-value'
        metricValue.dataset.i18nRelativeDate = date
        metricValue.textContent = relativeDate(date)
        sparklineWrap.hidden = true
      }

      window.dshI18n?.translate(row)
      return row
    }

    const getFilteredRepositories = () => {
      const query = searchInput.value.trim().toLocaleLowerCase('zh-CN')
      const filtered = repositories.filter((repository) => {
        const searchable = [
          repository.name,
          repository.fullName,
          repository.description,
          repository.language || '',
          ...repository.topics,
        ].join(' ').toLocaleLowerCase('zh-CN')
        return (!query || searchable.includes(query))
          && (selectedCategory === 'all' || repository.category === selectedCategory)
          && (selectedType === 'all' || repository.projectType === selectedType)
      })

      return filtered.sort((left, right) => {
        if (selectedRankingMode === 'starsToday') {
          const changePriority = right.starTrend.changeToday - left.starTrend.changeToday
          if (changePriority !== 0) return changePriority
        }
        if (selectedRankingMode === 'newest') {
          const createdPriority = Date.parse(right.createdAt) - Date.parse(left.createdAt)
          if (createdPriority !== 0) return createdPriority
        }
        if (selectedRankingMode === 'updated') {
          const updatedPriority = Date.parse(right.pushedAt) - Date.parse(left.pushedAt)
          if (updatedPriority !== 0) return updatedPriority
        }
        return right.stars - left.stars || left.fullName.localeCompare(right.fullName)
      })
    }

    const render = () => {
      const filtered = getFilteredRepositories()
      const visible = filtered.slice(0, visibleCount)
      list.replaceChildren(...visible.map((repository, index) => createRow(repository, index + 1)))
      resultCount.textContent = t('home.projectCount', { count: filtered.length }, `${filtered.length} 个项目`)
      emptyState.hidden = filtered.length !== 0
      list.hidden = filtered.length === 0
      const remaining = Math.max(0, filtered.length - visible.length)
      loadMore.hidden = remaining === 0
      remainingCount.textContent = String(remaining)
    }

    const resetAndRender = () => {
      visibleCount = pageSize
      render()
    }

    const syncFilterButtons = () => {
      typeFilter.querySelectorAll('[data-type]').forEach((item) => {
        const active = item.dataset.type === selectedType
        item.classList.toggle('is-active', active)
        item.setAttribute('aria-pressed', String(active))
      })
      categoryFilter.querySelectorAll('[data-category]').forEach((item) => {
        const active = item.dataset.category === selectedCategory
        item.classList.toggle('is-active', active)
        item.setAttribute('aria-pressed', String(active))
      })
      rankingFilter.querySelectorAll('[data-ranking-mode]').forEach((item) => {
        const active = item.dataset.rankingMode === selectedRankingMode
        item.classList.toggle('is-active', active)
        item.setAttribute('aria-pressed', String(active))
      })
    }

    const commitFilters = () => {
      syncFiltersToUrl()
      resetAndRender()
    }

    const setCategoryExpanded = (expanded) => {
      categoryFilterPanel.classList.add('is-collapsible')
      categoryFilterPanel.classList.toggle('is-expanded', expanded)
      categoryFilterToggle.setAttribute('aria-expanded', String(expanded))
      const labelKey = expanded ? 'home.collapseCategories' : 'home.expandCategories'
      const fallback = expanded ? '收起全部分类' : '展开全部分类'
      const label = t(labelKey, {}, fallback)
      categoryFilterToggle.dataset.i18nAriaLabel = labelKey
      categoryFilterToggle.dataset.i18nTitle = labelKey
      categoryFilterToggle.setAttribute('aria-label', label)
      categoryFilterToggle.setAttribute('title', label)
    }

    const restoreFiltersFromUrl = () => {
      const filters = new URLSearchParams(window.location.search)
      const requestedCategory = filters.get('category')
      const requestedType = filters.get('type')
      const requestedRankingMode = filters.get('rank')
      searchInput.value = filters.get('q') ?? ''
      selectedCategory = categoryById.has(requestedCategory) ? requestedCategory : 'all'
      selectedType = typeById.has(requestedType) ? requestedType : 'all'
      selectedRankingMode = rankingModeIds.has(requestedRankingMode) ? requestedRankingMode : 'starsToday'
      syncFilterButtons()
      setCategoryExpanded(selectedType !== 'all' || selectedCategory !== 'all')
    }

    setCategoryExpanded(false)
    categoryFilterToggle.addEventListener('click', () => {
      setCategoryExpanded(categoryFilterToggle.getAttribute('aria-expanded') !== 'true')
    })
    searchInput.addEventListener('input', commitFilters)
    typeFilter.addEventListener('click', (event) => {
      const button = event.target.closest('[data-type]')
      if (!button) return
      selectedType = button.dataset.type
      syncFilterButtons()
      commitFilters()
    })
    categoryFilter.addEventListener('click', (event) => {
      const button = event.target.closest('[data-category]')
      if (!button) return
      selectedCategory = button.dataset.category
      syncFilterButtons()
      commitFilters()
    })
    rankingFilter.addEventListener('click', (event) => {
      const button = event.target.closest('[data-ranking-mode]')
      if (!button) return
      selectedRankingMode = button.dataset.rankingMode
      syncFilterButtons()
      commitFilters()
    })
    loadMore.addEventListener('click', () => {
      visibleCount += pageSize
      render()
    })
    clearFilters.addEventListener('click', () => {
      searchInput.value = ''
      selectedType = 'all'
      selectedCategory = 'all'
      selectedRankingMode = 'starsToday'
      syncFilterButtons()
      setCategoryExpanded(false)
      commitFilters()
      searchInput.focus()
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== searchInput) {
        event.preventDefault()
        searchInput.focus()
      }
      if (event.key === 'Escape' && document.activeElement === searchInput) {
        searchInput.value = ''
        searchInput.blur()
        commitFilters()
      }
    })
    document.addEventListener('dsh:locale-change', render)
    restoreFiltersFromUrl()
    resetAndRender()
    }
    </script>
  )}
</BaseLayout>

<style>
  .store-install-strip {
    border-bottom: 1px solid var(--hairline);
    background: var(--canvas-soft);
  }

  .store-install-strip__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 2fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-height: 56px;
  }

  .store-install-label,
  .store-install-command {
    display: flex;
    align-items: center;
  }

  .store-install-label {
    min-height: 36px;
    gap: 8px;
    align-items: center;
    color: var(--body);
    font-size: 12px;
    line-height: 18px;
    white-space: nowrap;
  }

  .store-install-label :global(svg) {
    flex: 0 0 auto;
    color: #9fdda9;
  }

  .store-install-command {
    height: 36px;
